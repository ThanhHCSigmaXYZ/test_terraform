config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "raw_mes_eq_status",
  bigquery: {
    partitionBy: "etl_loaded_date",
    clusterBy: ["equipment_id"]
  }
}

-- This table copies data from the source mes_equipment_status and adds ETL metadata.
SELECT
  *,
  TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at,
  CURRENT_DATE() AS etl_loaded_date
FROM
  ${ref("mes_equipment_status")}
