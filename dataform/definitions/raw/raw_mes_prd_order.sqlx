config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "raw_mes_prd_order",
  tags: ["raw"],
  description: "MESからの製造実績データの取り込み（日次差分）"
}

-- Add etl_loaded_at and etl_loaded_date
SELECT
  *,
  TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at,
  CURRENT_DATE() AS etl_loaded_date
FROM
  ${ref("mes_production_order")}
