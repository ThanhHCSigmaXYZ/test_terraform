config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "raw_mes_prd_order",
  bigquery: {
    partitionBy: "etl_loaded_date",
    clusterBy: ["order_id"]
  }
}

--This table copies data from the source mes_production_order and adds ETL metadata.
SELECT
  *,
  TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at,
  CURRENT_DATE() AS etl_loaded_date
FROM
  ${ref("mes_production_order")}
