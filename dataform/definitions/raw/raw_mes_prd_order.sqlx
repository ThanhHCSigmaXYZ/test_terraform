config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "raw_mes_prd_order",
  description: "MESからの製造実績データの取り込み（日次差分）",
  tags: ["raw"],
  bigquery: {
    partitionBy: "etl_loaded_date",
    clusterBy: ["order_id"]
  }
}

SELECT
  *,
  CURRENT_TIMESTAMP() AS etl_loaded_at,
  DATE(CURRENT_TIMESTAMP()) AS etl_loaded_date
FROM
  ${ref("mes_production_order")}
