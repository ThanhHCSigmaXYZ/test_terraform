config {
  type: "test",
  dataset: "raw_erp_worker_master",
  name: "raw_erp_worker_master_test"
}

input "erp_worker_master" {
  SELECT 'w1' AS worker_id, 'Alice' AS worker_name, 'Group A' AS department UNION ALL
  SELECT 'w2' AS worker_id, 'Bob' AS worker_name, 'Group B' AS department UNION ALL
  SELECT 'w3' AS worker_id, 'Charlie' AS worker_name, 'Group A' AS department UNION ALL
  SELECT 'w4' AS worker_id, 'David' AS worker_name, 'Group C' AS department UNION ALL
  SELECT 'w5' AS worker_id, 'Eve' AS worker_name, 'Group B' AS department
}

SELECT
  'w1' AS worker_id, 'Alice' AS worker_name, 'Group A' AS department, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  SELECT 'w2' AS worker_id, 'Bob' AS worker_name, 'Group B' AS department, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  SELECT 'w3' AS worker_id, 'Charlie' AS worker_name, 'Group A' AS department, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  SELECT 'w4' AS worker_id, 'David' AS worker_name, 'Group C' AS department, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  SELECT 'w5' AS worker_id, 'Eve' AS worker_name, 'Group B' AS department, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
