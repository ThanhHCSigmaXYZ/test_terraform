config {
    type: "test",
    dataset: "raw_erp_worker_master"
}

input {
    name: "erp_worker_master",
    data: [
        {worker_id: "w1", worker_name: "Worker 1"},
        {worker_id: "w2", worker_name: "Worker 2"},
        {worker_id: "w3", worker_name: "Worker 3"},
        {worker_id: "w4", worker_name: "Worker 4"},
        {worker_id: "w5", worker_name: "Worker 5"}
    ]
}

SELECT "w1" AS worker_id, "Worker 1" AS worker_name, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT "w2" AS worker_id, "Worker 2" AS worker_name, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT "w3" AS worker_id, "Worker 3" AS worker_name, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT "w4" AS worker_id, "Worker 4" AS worker_name, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT "w5" AS worker_id, "Worker 5" AS worker_name, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
