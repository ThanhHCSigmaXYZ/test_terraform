config {
  type: "test",
  dataset: "raw_erp_worker_master"
}

input "erp_worker_master" {
  SELECT 'w1' as worker_id, 'Worker 1' as worker_name UNION ALL
  SELECT 'w2' as worker_id, 'Worker 2' as worker_name UNION ALL
  SELECT 'w3' as worker_id, 'Worker 3' as worker_name UNION ALL
  SELECT 'w4' as worker_id, 'Worker 4' as worker_name UNION ALL
  SELECT 'w5' as worker_id, 'Worker 5' as worker_name
}

SELECT
  'w1' as worker_id, 'Worker 1' as worker_name, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  'w2' as worker_id, 'Worker 2' as worker_name, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  'w3' as worker_id, 'Worker 3' as worker_name, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  'w4' as worker_id, 'Worker 4' as worker_name, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  'w5' as worker_id, 'Worker 5' as worker_name, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
