config {
  type: "test",
  dataset: "raw_mes_prd_order"
}

input "mes_production_order" {
  SELECT
    'order1' AS order_id,
    'serial1' AS product_serial_no
  UNION ALL
  SELECT
    'order2' AS order_id,
    'serial2' AS product_serial_no
  UNION ALL
  SELECT
    'order3' AS order_id,
    'serial3' AS product_serial_no
  UNION ALL
  SELECT
    'order4' AS order_id,
    'serial4' AS product_serial_no
  UNION ALL
  SELECT
    'order5' AS order_id,
    'serial5' AS product_serial_no
}

SELECT
  'order1' AS order_id,
  'serial1' AS product_serial_no,
  TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at,
  CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT
  'order2' AS order_id,
  'serial2' AS product_serial_no,
  TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at,
  CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT
  'order3' AS order_id,
  'serial3' AS product_serial_no,
  TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at,
  CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT
  'order4' AS order_id,
  'serial4' AS product_serial_no,
  TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at,
  CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT
  'order5' AS order_id,
  'serial5' AS product_serial_no,
  TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at,
  CURRENT_DATE() AS etl_loaded_date