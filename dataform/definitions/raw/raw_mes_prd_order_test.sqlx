config {
  type: "test",
  dataset: "raw_mes_prd_order"
}

input "mes_production_order" {
  SELECT 1 AS order_id, 'PN-1' AS product_serial_no UNION ALL
  SELECT 2 AS order_id, 'PN-2' AS product_serial_no UNION ALL
  SELECT 3 AS order_id, 'PN-3' AS product_serial_no UNION ALL
  SELECT 4 AS order_id, 'PN-4' AS product_serial_no UNION ALL
  SELECT 5 AS order_id, 'PN-5' AS product_serial_no
}

SELECT 1 AS order_id, 'PN-1' AS product_serial_no, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 2 AS order_id, 'PN-2' AS product_serial_no, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 3 AS order_id, 'PN-3' AS product_serial_no, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 4 AS order_id, 'PN-4' AS product_serial_no, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 5 AS order_id, 'PN-5' AS product_serial_no, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
