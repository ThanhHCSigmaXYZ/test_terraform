config {
  type: "test",
  dataset: "raw_iot_cnc_telemetry"
}

input "cnc_machine_telemetry" {
  SELECT 'machine1' as machine_id, TIMESTAMP('2023-01-01 10:00:00') as timestamp, '{"temp": 50, "vib": 1.2}' as payload UNION ALL
  SELECT 'machine1' as machine_id, TIMESTAMP('2023-01-01 10:00:01') as timestamp, '{"temp": 51, "vib": 1.3}' as payload UNION ALL
  SELECT 'machine2' as machine_id, TIMESTAMP('2023-01-01 10:00:00') as timestamp, '{"temp": 60, "vib": 2.2}' as payload UNION ALL
  SELECT 'machine1' as machine_id, TIMESTAMP('2023-01-01 10:00:02') as timestamp, '{"temp": 52, "vib": 1.4}' as payload UNION ALL
  SELECT 'machine2' as machine_id, TIMESTAMP('2023-01-01 10:00:01') as timestamp, '{"temp": 61, "vib": 2.3}' as payload
}

SELECT
  'machine1' as machine_id, TIMESTAMP('2023-01-01 10:00:00') as timestamp, '{"temp": 50, "vib": 1.2}' as payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  'machine1' as machine_id, TIMESTAMP('2023-01-01 10:00:01') as timestamp, '{"temp": 51, "vib": 1.3}' as payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  'machine2' as machine_id, TIMESTAMP('2023-01-01 10:00:00') as timestamp, '{"temp": 60, "vib": 2.2}' as payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  'machine1' as machine_id, TIMESTAMP('2023-01-01 10:00:02') as timestamp, '{"temp": 52, "vib": 1.4}' as payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  'machine2' as machine_id, TIMESTAMP('2023-01-01 10:00:01') as timestamp, '{"temp": 61, "vib": 2.3}' as payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
