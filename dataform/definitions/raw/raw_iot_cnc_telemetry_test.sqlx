config {
  type: "test",
  dataset: "raw_iot_cnc_telemetry"
}

input "cnc_machine_telemetry" {
  SELECT 'machine1' AS machine_id, TIMESTAMP('2023-01-01 10:00:00') AS timestamp, '{"temp": 25.5, "vibration": 0.1}' AS payload UNION ALL
  SELECT 'machine1' AS machine_id, TIMESTAMP('2023-01-01 10:00:01') AS timestamp, '{"temp": 25.6, "vibration": 0.12}' AS payload UNION ALL
  SELECT 'machine2' AS machine_id, TIMESTAMP('2023-01-01 11:00:00') AS timestamp, '{"temp": 30.1, "vibration": 0.2}' AS payload UNION ALL
  SELECT 'machine1' AS machine_id, TIMESTAMP('2023-01-01 10:00:02') AS timestamp, '{"temp": 25.7, "vibration": 0.11}' AS payload UNION ALL
  SELECT 'machine2' AS machine_id, TIMESTAMP('2023-01-01 11:00:01') AS timestamp, '{"temp": 30.2, "vibration": 0.21}' AS payload
}

SELECT
  'machine1' AS machine_id, TIMESTAMP('2023-01-01 10:00:00') AS timestamp, '{"temp": 25.5, "vibration": 0.1}' AS payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT
  'machine1' AS machine_id, TIMESTAMP('2023-01-01 10:00:01') AS timestamp, '{"temp": 25.6, "vibration": 0.12}' AS payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT
  'machine2' AS machine_id, TIMESTAMP('2023-01-01 11:00:00') AS timestamp, '{"temp": 30.1, "vibration": 0.2}' AS payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT
  'machine1' AS machine_id, TIMESTAMP('2023-01-01 10:00:02') AS timestamp, '{"temp": 25.7, "vibration": 0.11}' AS payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT
  'machine2' AS machine_id, TIMESTAMP('2023-01-01 11:00:01') AS timestamp, '{"temp": 30.2, "vibration": 0.21}' AS payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date