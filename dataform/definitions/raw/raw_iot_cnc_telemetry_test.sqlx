config {
  type: "test",
  dataset: "raw_iot_cnc_telemetry",
  name: "raw_iot_cnc_telemetry_test"
}

input "cnc_machine_telemetry" {
  SELECT 'machine1' AS machine_id, '2023-01-01T10:00:00Z' AS timestamp, '{"temp": 100, "vibration": 0.5}' AS payload UNION ALL
  SELECT 'machine1' AS machine_id, '2023-01-01T10:01:00Z' AS timestamp, '{"temp": 101, "vibration": 0.6}' AS payload UNION ALL
  SELECT 'machine2' AS machine_id, '2023-01-01T10:00:00Z' AS timestamp, '{"temp": 120, "vibration": 0.2}' AS payload UNION ALL
  SELECT 'machine2' AS machine_id, '2023-01-01T10:01:00Z' AS timestamp, '{"temp": 121, "vibration": 0.3}' AS payload UNION ALL
  SELECT 'machine1' AS machine_id, '2023-01-01T10:02:00Z' AS timestamp, '{"temp": 102, "vibration": 0.4}' AS payload
}

SELECT
  'machine1' AS machine_id, '2023-01-01T10:00:00Z' AS timestamp, '{"temp": 100, "vibration": 0.5}' AS payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  SELECT 'machine1' AS machine_id, '2023-01-01T10:01:00Z' AS timestamp, '{"temp": 101, "vibration": 0.6}' AS payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  SELECT 'machine2' AS machine_id, '2023-01-01T10:00:00Z' AS timestamp, '{"temp": 120, "vibration": 0.2}' AS payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  SELECT 'machine2' AS machine_id, '2023-01-01T10:01:00Z' AS timestamp, '{"temp": 121, "vibration": 0.3}' AS payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  SELECT 'machine1' AS machine_id, '2023-01-01T10:02:00Z' AS timestamp, '{"temp": 102, "vibration": 0.4}' AS payload, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
