config {
  type: "test",
  dataset: "raw_mes_eq_status"
}

input "mes_equipment_status" {
  SELECT 1 as status_log_id, 'eq1' as equipment_id, 'RUNNING' as status_code, TIMESTAMP('2023-01-01 10:00:00') as status_changed_at UNION ALL
  SELECT 2 as status_log_id, 'eq1' as equipment_id, 'STOPPED' as status_code, TIMESTAMP('2023-01-01 11:00:00') as status_changed_at UNION ALL
  SELECT 3 as status_log_id, 'eq2' as equipment_id, 'RUNNING' as status_code, TIMESTAMP('2023-01-01 10:00:00') as status_changed_at UNION ALL
  SELECT 4 as status_log_id, 'eq1' as equipment_id, 'RUNNING' as status_code, TIMESTAMP('2023-01-01 12:00:00') as status_changed_at UNION ALL
  SELECT 5 as status_log_id, 'eq2' as equipment_id, 'ERROR' as status_code, TIMESTAMP('2023-01-01 11:30:00') as status_changed_at
}

SELECT
  1 as status_log_id, 'eq1' as equipment_id, 'RUNNING' as status_code, TIMESTAMP('2023-01-01 10:00:00') as status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  2 as status_log_id, 'eq1' as equipment_id, 'STOPPED' as status_code, TIMESTAMP('2023-01-01 11:00:00') as status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  3 as status_log_id, 'eq2' as equipment_id, 'RUNNING' as status_code, TIMESTAMP('2023-01-01 10:00:00') as status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  4 as status_log_id, 'eq1' as equipment_id, 'RUNNING' as status_code, TIMESTAMP('2023-01-01 12:00:00') as status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  5 as status_log_id, 'eq2' as equipment_id, 'ERROR' as status_code, TIMESTAMP('2023-01-01 11:30:00') as status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
