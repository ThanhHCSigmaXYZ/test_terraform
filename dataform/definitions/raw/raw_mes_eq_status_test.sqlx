config {
  type: "test",
  dataset: "raw_mes_eq_status"
}

input "mes_equipment_status" {
  SELECT 'log1' AS status_log_id, 'equip1' AS equipment_id, 'RUN' AS status_code, TIMESTAMP('2026-03-17 10:00:00') AS status_changed_at UNION ALL
  SELECT 'log2' AS status_log_id, 'equip1' AS equipment_id, 'STOP' AS status_code, TIMESTAMP('2026-03-17 11:00:00') AS status_changed_at UNION ALL
  SELECT 'log3' AS status_log_id, 'equip2' AS equipment_id, 'RUN' AS status_code, TIMESTAMP('2026-03-17 10:30:00') AS status_changed_at UNION ALL
  SELECT 'log4' AS status_log_id, 'equip1' AS equipment_id, 'RUN' AS status_code, TIMESTAMP('2026-03-17 12:00:00') AS status_changed_at UNION ALL
  SELECT 'log5' AS status_log_id, 'equip2' AS equipment_id, 'IDLE' AS status_code, TIMESTAMP('2026-03-17 11:30:00') AS status_changed_at
}

SELECT 'log1' AS status_log_id, 'equip1' AS equipment_id, 'RUN' AS status_code, TIMESTAMP('2026-03-17 10:00:00') AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 'log2' AS status_log_id, 'equip1' AS equipment_id, 'STOP' AS status_code, TIMESTAMP('2026-03-17 11:00:00') AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 'log3' AS status_log_id, 'equip2' AS equipment_id, 'RUN' AS status_code, TIMESTAMP('2026-03-17 10:30:00') AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 'log4' AS status_log_id, 'equip1' AS equipment_id, 'RUN' AS status_code, TIMESTAMP('2026-03-17 12:00:00') AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 'log5' AS status_log_id, 'equip2' AS equipment_id, 'IDLE' AS status_code, TIMESTAMP('2026-03-17 11:30:00') AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
