config {
  type: "test",
  dataset: "raw_mes_eq_status"
}

input "mes_equipment_status" {
  SELECT 'log1' AS status_log_id, 'eq1' AS equipment_id, 'C01' AS status_code, TIMESTAMP('2023-01-01 10:00:00') AS status_changed_at UNION ALL
  SELECT 'log2' AS status_log_id, 'eq1' AS equipment_id, 'C02' AS status_code, TIMESTAMP('2023-01-01 10:05:00') AS status_changed_at UNION ALL
  SELECT 'log3' AS status_log_id, 'eq2' AS equipment_id, 'C01' AS status_code, TIMESTAMP('2023-01-01 11:00:00') AS status_changed_at UNION ALL
  SELECT 'log4' AS status_log_id, 'eq1' AS equipment_id, 'C03' AS status_code, TIMESTAMP('2023-01-01 10:10:00') AS status_changed_at UNION ALL
  SELECT 'log5' AS status_log_id, 'eq2' AS equipment_id, 'C05' AS status_code, TIMESTAMP('2023-01-01 11:30:00') AS status_changed_at
}

SELECT
  'log1' AS status_log_id, 'eq1' AS equipment_id, 'C01' AS status_code, TIMESTAMP('2023-01-01 10:00:00') AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT
  'log2' AS status_log_id, 'eq1' AS equipment_id, 'C02' AS status_code, TIMESTAMP('2023-01-01 10:05:00') AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT
  'log3' AS status_log_id, 'eq2' AS equipment_id, 'C01' AS status_code, TIMESTAMP('2023-01-01 11:00:00') AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT
  'log4' AS status_log_id, 'eq1' AS equipment_id, 'C03' AS status_code, TIMESTAMP('2023-01-01 10:10:00') AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
UNION ALL
SELECT
  'log5' AS status_log_id, 'eq2' AS equipment_id, 'C05' AS status_code, TIMESTAMP('2023-01-01 11:30:00') AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date