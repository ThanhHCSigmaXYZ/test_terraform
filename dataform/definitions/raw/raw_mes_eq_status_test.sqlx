config {
  type: "test",
  dataset: "raw_mes_eq_status"
}

input "mes_equipment_status" {
  SELECT 1 AS status_log_id, 'EQ-1' AS equipment_id, 'RUNNING' AS status_code, '2023-01-01 00:00:00' AS status_changed_at UNION ALL
  SELECT 2 AS status_log_id, 'EQ-1' AS equipment_id, 'STOPPED' AS status_code, '2023-01-01 01:00:00' AS status_changed_at UNION ALL
  SELECT 3 AS status_log_id, 'EQ-2' AS equipment_id, 'RUNNING' AS status_code, '2023-01-01 00:00:00' AS status_changed_at UNION ALL
  SELECT 4 AS status_log_id, 'EQ-2' AS equipment_id, 'MAINTENANCE' AS status_code, '2023-01-01 02:00:00' AS status_changed_at UNION ALL
  SELECT 5 AS status_log_id, 'EQ-1' AS equipment_id, 'RUNNING' AS status_code, '2023-01-01 03:00:00' AS status_changed_at
}

SELECT 1 AS status_log_id, 'EQ-1' AS equipment_id, 'RUNNING' AS status_code, '2023-01-01 00:00:00' AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 2 AS status_log_id, 'EQ-1' AS equipment_id, 'STOPPED' AS status_code, '2023-01-01 01:00:00' AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 3 AS status_log_id, 'EQ-2' AS equipment_id, 'RUNNING' AS status_code, '2023-01-01 00:00:00' AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 4 AS status_log_id, 'EQ-2' AS equipment_id, 'MAINTENANCE' AS status_code, '2023-01-01 02:00:00' AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 5 AS status_log_id, 'EQ-1' AS equipment_id, 'RUNNING' AS status_code, '2023-01-01 03:00:00' AS status_changed_at, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
