config {
  type: "test",
  dataset: "raw_qms_inspection"
}

input "qms_inspection_result" {
  SELECT 1 AS inspection_id, 'PN-1' AS product_serial_no, 'PASS' AS result UNION ALL
  SELECT 2 AS inspection_id, 'PN-2' AS product_serial_no, 'FAIL' AS result UNION ALL
  SELECT 3 AS inspection_id, 'PN-3' AS product_serial_no, 'PASS' AS result UNION ALL
  SELECT 4 AS inspection_id, 'PN-4' AS product_serial_no, 'PASS' AS result UNION ALL
  SELECT 5 AS inspection_id, 'PN-5' AS product_serial_no, 'FAIL' AS result
}

SELECT 1 AS inspection_id, 'PN-1' AS product_serial_no, 'PASS' AS result, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 2 AS inspection_id, 'PN-2' AS product_serial_no, 'FAIL' AS result, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 3 AS inspection_id, 'PN-3' AS product_serial_no, 'PASS' AS result, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 4 AS inspection_id, 'PN-4' AS product_serial_no, 'PASS' AS result, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
SELECT 5 AS inspection_id, 'PN-5' AS product_serial_no, 'FAIL' AS result, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
