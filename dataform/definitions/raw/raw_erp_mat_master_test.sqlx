config {
  type: "test",
  dataset: "raw_erp_mat_master"
}

input "erp_material_master" {
  SELECT 'mat1' as material_id, 'Material 1' as description UNION ALL
  SELECT 'mat2' as material_id, 'Material 2' as description UNION ALL
  SELECT 'mat3' as material_id, 'Material 3' as description UNION ALL
  SELECT 'mat4' as material_id, 'Material 4' as description UNION ALL
  SELECT 'mat5' as material_id, 'Material 5' as description
}

SELECT
  'mat1' as material_id, 'Material 1' as description, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  'mat2' as material_id, 'Material 2' as description, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  'mat3' as material_id, 'Material 3' as description, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  'mat4' as material_id, 'Material 4' as description, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date UNION ALL
  'mat5' as material_id, 'Material 5' as description, TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at, CURRENT_DATE() AS etl_loaded_date
