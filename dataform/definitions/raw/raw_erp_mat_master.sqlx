config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "raw_erp_mat_master"
}

-- This table copies data from the source erp_material_master and adds ETL metadata.
SELECT
  *,
  TIMESTAMP(CURRENT_DATE()) AS etl_loaded_at,
  CURRENT_DATE() AS etl_loaded_date
FROM
  ${ref("erp_material_master")}
