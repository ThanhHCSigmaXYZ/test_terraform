config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "tmp_erp_mat_master_scd2",
  tags: ["processed"],
  description: "品目マスタのSCD Type2処理（履歴化）",
  dataformCore: "3.0.7",
  clusterBy: ["material_id"]
}

-- This is a placeholder for a real SCD Type 2 implementation.
-- A full implementation would typically involve comparing against the
-- existing dimension table to detect changes and create new versions.
-- This simplified example just adds history columns.
SELECT
  material_id,
  material_name,
  etl_loaded_at AS valid_from,
  LEAD(etl_loaded_at, 1, TIMESTAMP('9999-12-31 23:59:59')) OVER (PARTITION BY material_id ORDER BY etl_loaded_at) AS valid_to,
  (LEAD(etl_loaded_at, 1) OVER (PARTITION BY material_id ORDER BY etl_loaded_at) IS NULL) AS is_current
FROM
  ${ref("raw_erp_mat_master")}
