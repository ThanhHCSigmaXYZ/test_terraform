config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "tmp_erp_mat_master_scd2",
  bigquery: {
    clusterBy: ["material_id"]
  }
}

-- This table creates a Type 2 Slowly Changing Dimension for the material master.
-- It tracks the history of changes by assigning a valid_from and valid_to timestamp to each version of a record.

WITH ranked_changes AS (
  SELECT
    *,
    LEAD(etl_loaded_at, 1, TIMESTAMP('9999-12-31 23:59:59')) OVER (PARTITION BY material_id ORDER BY etl_loaded_at) as next_load_time
  FROM
    ${ref("raw_erp_mat_master")}
)
SELECT
  material_id,
  description,
  -- other attributes of the master data
  etl_loaded_at AS valid_from,
  next_load_time AS valid_to,
  (next_load_time = TIMESTAMP('9999-12-31 23:59:59')) AS is_current
FROM
  ranked_changes
