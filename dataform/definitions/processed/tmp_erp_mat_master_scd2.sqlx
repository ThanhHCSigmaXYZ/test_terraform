config {
    type: "table",
    schema: "dev_dataform_dataset",
    name: "tmp_erp_mat_master_scd2",
    bigquery: {
        clusterBy: ["material_id"]
    }
}

WITH changes AS (
    SELECT
        material_id,
        material_name,
        etl_loaded_date,
        -- Create a hash to detect changes in relevant columns
        FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(material_name))) AS row_hash,
        LAG(FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(material_name))), 1) OVER (PARTITION BY material_id ORDER BY etl_loaded_date) AS prev_row_hash
    FROM ${ref("raw_erp_mat_master")}
),
scd2_logic AS (
    SELECT
        material_id,
        material_name,
        etl_loaded_date AS valid_from,
        -- The record is valid until the next change
        LEAD(etl_loaded_date, 1, DATE('9999-12-31')) OVER (PARTITION BY material_id ORDER BY etl_loaded_date) AS valid_to,
        -- The latest record for each material is the current one
        (ROW_NUMBER() OVER (PARTITION BY material_id ORDER BY etl_loaded_date DESC) = 1) AS is_current
    FROM changes
    -- A change is when the hash is different from the previous one
    WHERE prev_row_hash IS NULL OR row_hash != prev_row_hash
)
SELECT * FROM scd2_logic
