-- NOTE: expected output derived from mock data — verify if transformation logic changes
config {
  type: "test",
  dataset: "tmp_mes_eq_status_agg"
}

input "raw_mes_eq_status" {
  SELECT 'log1' AS status_log_id, 'equip1' AS equipment_id, 'RUN' AS status_code, TIMESTAMP('2026-03-17 10:00:00') AS status_changed_at UNION ALL
  SELECT 'log2' AS status_log_id, 'equip1' AS equipment_id, 'STOP' AS status_code, TIMESTAMP('2026-03-17 10:05:00') AS status_changed_at UNION ALL
  SELECT 'log3' AS status_log_id, 'equip2' AS equipment_id, 'RUN' AS status_code, TIMESTAMP('2026-03-17 10:00:00') AS status_changed_at UNION ALL
  SELECT 'log4' AS status_log_id, 'equip1' AS equipment_id, 'E-101' AS status_code, TIMESTAMP('2026-03-17 10:15:00') AS status_changed_at UNION ALL
  SELECT 'log5' AS status_log_id, 'equip2' AS equipment_id, 'E-102' AS status_code, TIMESTAMP('2026-03-17 10:20:00') AS status_changed_at
}

SELECT 'log1' AS status_log_id, 'equip1' AS equipment_id, 'RUN' AS status_code, DATE('2026-03-17') as status_date, TIMESTAMP('2026-03-17 10:00:00') AS status_changed_at, NULL AS duration_sec UNION ALL
SELECT 'log2' AS status_log_id, 'equip1' AS equipment_id, 'STOP' AS status_code, DATE('2026-03-17') as status_date, TIMESTAMP('2026-03-17 10:05:00') AS status_changed_at, 300 AS duration_sec UNION ALL
SELECT 'log3' AS status_log_id, 'equip2' AS equipment_id, 'RUN' AS status_code, DATE('2026-03-17') as status_date, TIMESTAMP('2026-03-17 10:00:00') AS status_changed_at, NULL AS duration_sec UNION ALL
SELECT 'log4' AS status_log_id, 'equip1' AS equipment_id, 'ERR-GEN' AS status_code, DATE('2026-03-17') as status_date, TIMESTAMP('2026-03-17 10:15:00') AS status_changed_at, 600 AS duration_sec UNION ALL
SELECT 'log5' AS status_log_id, 'equip2' AS equipment_id, 'ERR-MECH' AS status_code, DATE('2026-03-17') as status_date, TIMESTAMP('2026-03-17 10:20:00') AS status_changed_at, 1200 AS duration_sec
