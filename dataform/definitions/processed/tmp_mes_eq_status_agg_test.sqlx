config {
  type: "test",
  dataset: "tmp_mes_eq_status_agg"
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes

input "raw_mes_eq_status" {
  SELECT 1 as status_log_id, 'eq1' as equipment_id, 'RUNNING' as status_code, TIMESTAMP('2023-01-01 10:00:00') as status_changed_at UNION ALL
  SELECT 2 as status_log_id, 'eq1' as equipment_id, 'STOPPED' as status_code, TIMESTAMP('2023-01-01 11:00:00') as status_changed_at UNION ALL
  SELECT 3 as status_log_id, 'eq1' as equipment_id, 'RUNNING' as status_code, TIMESTAMP('2023-01-01 11:30:00') as status_changed_at UNION ALL
  SELECT 4 as status_log_id, 'eq2' as equipment_id, 'RUNNING' as status_code, TIMESTAMP('2023-01-01 09:00:00') as status_changed_at UNION ALL
  SELECT 5 as status_log_id, 'eq2' as equipment_id, 'ERR_A' as status_code, TIMESTAMP('2023-01-01 10:30:00') as status_changed_at
}

-- Expected output is ordered by equipment_id, then status_changed_at to match the window function partitioning
SELECT
  1 as status_log_id, 'eq1' as equipment_id, 'RUNNING' as status_code, TIMESTAMP('2023-01-01 10:00:00') as status_changed_at, DATE('2023-01-01') as status_date, NULL as duration_sec
UNION ALL
SELECT
  2 as status_log_id, 'eq1' as equipment_id, 'STOPPED' as status_code, TIMESTAMP('2023-01-01 11:00:00') as status_changed_at, DATE('2023-01-01') as status_date, 3600 as duration_sec
UNION ALL
SELECT
  3 as status_log_id, 'eq1' as equipment_id, 'RUNNING' as status_code, TIMESTAMP('2023-01-01 11:30:00') as status_changed_at, DATE('2023-01-01') as status_date, 1800 as duration_sec
UNION ALL
SELECT
  4 as status_log_id, 'eq2' as equipment_id, 'RUNNING' as status_code, TIMESTAMP('2023-01-01 09:00:00') as status_changed_at, DATE('2023-01-01') as status_date, NULL as duration_sec
UNION ALL
SELECT
  5 as status_log_id, 'eq2' as equipment_id, 'UNIFIED_ERROR' as status_code, TIMESTAMP('2023-01-01 10:30:00') as status_changed_at, DATE('2023-01-01') as status_date, 5400 as duration_sec
