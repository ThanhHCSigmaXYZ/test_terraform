config {
  type: "test",
  dataset: "tmp_mes_eq_status_agg",
  name: "tmp_mes_eq_status_agg_test"
}

input "raw_mes_eq_status" {
  SELECT 'log1' AS status_log_id, 'eq1' AS equipment_id, 'RUN' AS status_code, '2023-01-10 10:00:00' as status_changed_at UNION ALL
  SELECT 'log2' AS status_log_id, 'eq1' AS equipment_id, 'STOP' AS status_code, '2023-01-10 10:30:00' as status_changed_at UNION ALL
  SELECT 'log3' AS status_log_id, 'eq1' AS equipment_id, 'RUN' AS status_code, '2023-01-10 10:45:00' as status_changed_at UNION ALL
  SELECT 'log4' AS status_log_id, 'eq2' AS equipment_id, 'RUN' AS status_code, '2023-01-10 11:00:00' as status_changed_at UNION ALL
  SELECT 'log5' AS status_log_id, 'eq2' AS equipment_id, 'STOP' AS status_code, '2023-01-10 12:00:00' as status_changed_at
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT
  'log1' AS status_log_id, 'eq1' AS equipment_id, 'RUN' AS status_code, TIMESTAMP('2023-01-10 10:00:00') as status_changed_at, DATE('2023-01-10') as status_date, 0 AS duration_sec UNION ALL
  SELECT 'log2' AS status_log_id, 'eq1' AS equipment_id, 'STOP' AS status_code, TIMESTAMP('2023-01-10 10:30:00') as status_changed_at, DATE('2023-01-10') as status_date, 1800 AS duration_sec UNION ALL
  SELECT 'log3' AS status_log_id, 'eq1' AS equipment_id, 'RUN' AS status_code, TIMESTAMP('2023-01-10 10:45:00') as status_changed_at, DATE('2023-01-10') as status_date, 900 AS duration_sec UNION ALL
  SELECT 'log4' AS status_log_id, 'eq2' AS equipment_id, 'RUN' AS status_code, TIMESTAMP('2023-01-10 11:00:00') as status_changed_at, DATE('2023-01-10') as status_date, 0 AS duration_sec UNION ALL
  SELECT 'log5' AS status_log_id, 'eq2' AS equipment_id, 'STOP' AS status_code, TIMESTAMP('2023-01-10 12:00:00') as status_changed_at, DATE('2023-01-10') as status_date, 3600 AS duration_sec

