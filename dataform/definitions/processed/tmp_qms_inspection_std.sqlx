config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "tmp_qms_inspection_std",
  tags: ["processed"],
  description: "品質検査結果CSVの型変換と単位正規化",
  dataformCore: "3.0.7",
  partitionBy: "inspection_date",
  clusterBy: ["product_serial_no"]
}

-- Assuming all columns are strings in raw table
SELECT
  inspection_id,
  product_serial_no,
  SAFE_CAST(inspection_date_str AS DATE) as inspection_date,
  -- Example of unit conversion (cm to mm)
  SAFE_CAST(measurement_cm AS FLOAT64) * 10 as measurement_mm,
  result
FROM
  ${ref("raw_qms_inspection")}
-- This is a simplified transformation. A real-world scenario would
-- have more complex logic for casting and unit conversion based on item type.
