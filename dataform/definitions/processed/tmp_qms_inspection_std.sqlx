config {
    type: "table",
    schema: "dev_dataform_dataset",
    name: "tmp_qms_inspection_std",
    partition_by: "inspection_date",
    cluster_by: ["product_serial_no"]
}

SELECT
    inspection_id,
    product_serial_no,
    CAST(inspection_date_str AS DATE) as inspection_date,
    -- ・単位が異なる検査項目（mmとcmなど）を標準単位に換算して統一
    CASE
        WHEN unit_str = 'cm' THEN CAST(inspection_value_str AS FLOAT64) * 10
        WHEN unit_str = 'mm' THEN CAST(inspection_value_str AS FLOAT64)
        ELSE CAST(inspection_value_str AS FLOAT64)
    END as inspection_value_mm
FROM
    ${ref("raw_qms_inspection")}
