-- NOTE: expected output derived from mock data — verify if transformation logic changes
config {
    type: "test",
    dataset: "tmp_erp_worker_master_scd2"
}

input "raw_erp_worker_master" {
    SELECT 'w1' AS worker_id, 'Worker 1 v1' AS worker_name, DATE('2023-01-01') AS etl_loaded_date UNION ALL
    SELECT 'w2' AS worker_id, 'Worker 2 v1' AS worker_name, DATE('2023-01-01') AS etl_loaded_date UNION ALL
    SELECT 'w1' AS worker_id, 'Worker 1 v2' AS worker_name, DATE('2023-01-02') AS etl_loaded_date UNION ALL
    SELECT 'w3' AS worker_id, 'Worker 3 v1' AS worker_name, DATE('2023-01-02') AS etl_loaded_date UNION ALL
    SELECT 'w1' AS worker_id, 'Worker 1 v3' AS worker_name, DATE('2023-01-03') AS etl_loaded_date
}

-- Expected output after SCD2 logic
SELECT
    'w1' AS worker_id, 'Worker 1 v1' AS worker_name, DATE('2023-01-01') AS valid_from, DATE('2023-01-02') AS valid_to, false AS is_current
UNION ALL
SELECT
    'w1' AS worker_id, 'Worker 1 v2' AS worker_name, DATE('2023-01-02') AS valid_from, DATE('2023-01-03') AS valid_to, false AS is_current
UNION ALL
SELECT
    'w1' AS worker_id, 'Worker 1 v3' AS worker_name, DATE('2023-01-03') AS valid_from, DATE('9999-12-31') AS valid_to, true AS is_current
UNION ALL
SELECT
    'w2' AS worker_id, 'Worker 2 v1' AS worker_name, DATE('2023-01-01') AS valid_from, DATE('9999-12-31') AS valid_to, true AS is_current
UNION ALL
SELECT
    'w3' AS worker_id, 'Worker 3 v1' AS worker_name, DATE('2023-01-02') AS valid_from, DATE('9999-12-31') AS valid_to, true AS is_current
