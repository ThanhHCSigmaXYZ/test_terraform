config {
  type: "test",
  dataset: "tmp_erp_worker_master_scd2",
  name: "tmp_erp_worker_master_scd2_test"
}

input "raw_erp_worker_master" {
  SELECT 'w1' AS worker_id, 'Alice' AS worker_name, TIMESTAMP('2023-01-01 10:00:00') as etl_loaded_at UNION ALL
  SELECT 'w1' AS worker_id, 'Alicia' AS worker_name, TIMESTAMP('2023-01-15 10:00:00') as etl_loaded_at UNION ALL
  SELECT 'w2' AS worker_id, 'Bob' AS worker_name, TIMESTAMP('2023-01-02 10:00:00') as etl_loaded_at UNION ALL
  SELECT 'w3' AS worker_id, 'Charlie' AS worker_name, TIMESTAMP('2023-02-01 10:00:00') as etl_loaded_at UNION ALL
  SELECT 'w2' AS worker_id, 'Robert' AS worker_name, TIMESTAMP('2023-02-20 10:00:00') as etl_loaded_at
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
-- Note: worker_name_hash is not calculated as it's non-deterministic without the exact hash function output
SELECT
  'w1' AS worker_id, NULL as worker_name_hash, TIMESTAMP('2023-01-01 10:00:00') AS valid_from, TIMESTAMP('2023-01-15 10:00:00') AS valid_to, false AS is_current UNION ALL
  SELECT 'w1' AS worker_id, NULL as worker_name_hash, TIMESTAMP('2023-01-15 10:00:00') AS valid_from, TIMESTAMP('9999-12-31 23:59:59') AS valid_to, true AS is_current UNION ALL
  SELECT 'w2' AS worker_id, NULL as worker_name_hash, TIMESTAMP('2023-01-02 10:00:00') AS valid_from, TIMESTAMP('2023-02-20 10:00:00') AS valid_to, false AS is_current UNION ALL
  SELECT 'w2' AS worker_id, NULL as worker_name_hash, TIMESTAMP('2023-02-20 10:00:00') AS valid_from, TIMESTAMP('9999-12-31 23:59:59') AS valid_to, true AS is_current UNION ALL
  SELECT 'w3' AS worker_id, NULL as worker_name_hash, TIMESTAMP('2023-02-01 10:00:00') AS valid_from, TIMESTAMP('9999-12-31 23:59:59') AS valid_to, true AS is_current
