config {
  type: "test",
  dataset: "tmp_erp_worker_master_scd2"
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes

input "raw_erp_worker_master" {
  SELECT 'w1' as worker_id, 'Worker One' as worker_name, 'Dept A' as department, TIMESTAMP('2023-01-01 08:00:00') as etl_loaded_at UNION ALL
  SELECT 'w1' as worker_id, 'Worker One Changed' as worker_name, 'Dept B' as department, TIMESTAMP('2023-01-15 08:00:00') as etl_loaded_at UNION ALL
  SELECT 'w2' as worker_id, 'Worker Two' as worker_name, 'Dept C' as department, TIMESTAMP('2023-01-02 08:00:00') as etl_loaded_at
}

SELECT
  SHA256('w1') as worker_id, '-- Anonymized --' as worker_name, 'Dept A' as department, TIMESTAMP('2023-01-01 08:00:00') as valid_from, TIMESTAMP('2023-01-15 08:00:00') as valid_to, false as is_current
UNION ALL
SELECT
  SHA256('w1') as worker_id, '-- Anonymized --' as worker_name, 'Dept B' as department, TIMESTAMP('2023-01-15 08:00:00') as valid_from, TIMESTAMP('9999-12-31 23:59:59') as valid_to, true as is_current
UNION ALL
SELECT
  SHA256('w2') as worker_id, '-- Anonymized --' as worker_name, 'Dept C' as department, TIMESTAMP('2023-01-02 08:00:00') as valid_from, TIMESTAMP('9999-12-31 23:59:59') as valid_to, true as is_current
