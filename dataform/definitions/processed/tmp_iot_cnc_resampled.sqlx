config {
    type: "table",
    schema: "dev_dataform_dataset",
    name: "tmp_iot_cnc_resampled",
    partition_by: "telemetry_date",
    cluster_by: ["machine_id"]
}

WITH
Step1_parsed AS (
    -- ① JSON内の温度・振動データをカラムに展開
    SELECT
        machine_id,
        timestamp,
        CAST(JSON_VALUE(payload, '$.temp') AS FLOAT64) as temperature,
        CAST(JSON_VALUE(payload, '$.vib') AS FLOAT64) as vibration
    FROM
        ${ref("raw_iot_cnc_telemetry")}
),
Step2_filtered AS (
    -- ② 極端な外れ値（センサー異常）の除外
    SELECT *
    FROM Step1_parsed
    WHERE
        temperature BETWEEN 0 AND 1000 -- Assuming a valid temperature range
        AND vibration BETWEEN 0 AND 1 -- Assuming a valid vibration range
)
-- ③ 残ったデータを1秒単位の平均値に丸め（ダウンサンプリング）
SELECT
    machine_id,
    TIMESTAMP_TRUNC(timestamp, SECOND) as telemetry_timestamp,
    DATE(TIMESTAMP_TRUNC(timestamp, SECOND)) as telemetry_date,
    AVG(temperature) as temperature,
    AVG(vibration) as vibration
FROM Step2_filtered
GROUP BY 1, 2, 3
