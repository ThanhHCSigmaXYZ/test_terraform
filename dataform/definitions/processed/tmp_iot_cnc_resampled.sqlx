config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "tmp_iot_cnc_resampled",
  description: "IoTデータ（JSON）の展開とダウンサンプリング",
  tags: ["processed"],
  bigquery: {
    partitionBy: "telemetry_date",
    clusterBy: ["machine_id"]
  }
}

WITH
  extracted_payload AS (
    SELECT
      machine_id,
      timestamp,
      -- ①JSON内の温度・振動データをカラムに展開
      CAST(JSON_EXTRACT_SCALAR(payload, '$.temp') AS FLOAT64) AS temperature,
      CAST(JSON_EXTRACT_SCALAR(payload, '$.vibration') AS FLOAT64) AS vibration
    FROM
      ${ref("raw_iot_cnc_telemetry")}
  ),
  filtered_outliers AS (
    SELECT
      *
    FROM
      extracted_payload
    -- ②極端な外れ値（センサー異常）の除外 (e.g. temp > 0 and temp < 1000)
    WHERE
      temperature BETWEEN 0 AND 1000
  )
SELECT
  machine_id,
  -- ③残ったデータを1秒単位の平均値に丸め（ダウンサンプリング）
  TIMESTAMP_TRUNC(timestamp, SECOND) AS telemetry_timestamp,
  DATE(TIMESTAMP_TRUNC(timestamp, SECOND)) as telemetry_date,
  AVG(temperature) AS avg_temperature,
  AVG(vibration) AS avg_vibration
FROM
  filtered_outliers
GROUP BY
  1,
  2,
  3
