config {
  type: "test",
  dataset: "tmp_iot_cnc_resampled",
  name: "tmp_iot_cnc_resampled_test"
}

input "raw_iot_cnc_telemetry" {
  SELECT 'm1' as machine_id, '2023-01-11 10:00:00.200Z' as timestamp, '{"temperature": 100.1, "vibration": 0.5}' as payload UNION ALL
  SELECT 'm1' as machine_id, '2023-01-11 10:00:00.800Z' as timestamp, '{"temperature": 100.3, "vibration": 0.7}' as payload UNION ALL
  SELECT 'm1' as machine_id, '2023-01-11 10:00:01.500Z' as timestamp, '{"temperature": 101.0, "vibration": 0.6}' as payload UNION ALL
  SELECT 'm2' as machine_id, '2023-01-11 10:00:00.400Z' as timestamp, '{"temperature": 200.0, "vibration": 0.2}' as payload UNION ALL
  SELECT 'm1' as machine_id, '2023-01-11 10:00:01.900Z' as timestamp, '{"temperature": 9999.0, "vibration": 0.5}' as payload -- Outlier
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT
  'm1' as machine_id, TIMESTAMP('2023-01-11 10:00:00') as telemetry_timestamp, (100.1+100.3)/2 as temperature, (0.5+0.7)/2 as vibration, DATE('2023-01-11') as telemetry_date UNION ALL
  SELECT 'm1' as machine_id, TIMESTAMP('2023-01-11 10:00:01') as telemetry_timestamp, 101.0 as temperature, 0.6 as vibration, DATE('2023-01-11') as telemetry_date UNION ALL
  SELECT 'm2' as machine_id, TIMESTAMP('2023-01-11 10:00:00') as telemetry_timestamp, 200.0 as temperature, 0.2 as vibration, DATE('2023-01-11') as telemetry_date
