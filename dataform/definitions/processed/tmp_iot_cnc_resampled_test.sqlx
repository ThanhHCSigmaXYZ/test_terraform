config {
  type: "test",
  dataset: "tmp_iot_cnc_resampled"
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes

input "raw_iot_cnc_telemetry" {
  SELECT 'm1' as machine_id, TIMESTAMP('2023-01-01 10:00:00.100Z') as timestamp, '{"temp": 100.1, "vib": 0.5}' as payload UNION ALL
  SELECT 'm1' as machine_id, TIMESTAMP('2023-01-01 10:00:00.300Z') as timestamp, '{"temp": 100.3, "vib": 0.6}' as payload UNION ALL
  SELECT 'm1' as machine_id, TIMESTAMP('2023-01-01 10:00:00.900Z') as timestamp, '{"temp": 100.5, "vib": 0.7}' as payload UNION ALL
  -- This record should be filtered out as an outlier
  SELECT 'm1' as machine_id, TIMESTAMP('2023-01-01 10:00:01.200Z') as timestamp, '{"temp": 9999, "vib": 99.9}' as payload UNION ALL
  SELECT 'm2' as machine_id, TIMESTAMP('2023-01-01 12:00:00.500Z') as timestamp, '{"temp": 150.0, "vib": 1.5}' as payload
}

SELECT
  'm1' AS machine_id,
  TIMESTAMP('2023-01-01 10:00:00Z') AS telemetry_timestamp,
  DATE('2023-01-01') as telemetry_date,
  (100.1 + 100.3 + 100.5) / 3 AS temperature,
  (0.5 + 0.6 + 0.7) / 3 AS vibration
UNION ALL
SELECT
  'm2' AS machine_id,
  TIMESTAMP('2023-01-01 12:00:00Z') AS telemetry_timestamp,
  DATE('2023-01-01') as telemetry_date,
  150.0 as temperature,
  1.5 as vibration
