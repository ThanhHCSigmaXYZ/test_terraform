config {
  type: "test",
  dataset: "tmp_iot_cnc_resampled"
}

input "raw_iot_cnc_telemetry" {
  SELECT 'machine1' AS machine_id, TIMESTAMP('2023-01-01 10:00:00.123') AS timestamp, '{"temperature": 25.5, "vibration": 0.1}' AS payload UNION ALL
  SELECT 'machine1' AS machine_id, TIMESTAMP('2023-01-01 10:00:00.567') AS timestamp, '{"temperature": 25.7, "vibration": 0.12}' AS payload UNION ALL
  SELECT 'machine2' AS machine_id, TIMESTAMP('2023-01-01 11:00:00.456') AS timestamp, '{"temperature": 30.1, "vibration": 0.2}' AS payload UNION ALL
  SELECT 'machine1' AS machine_id, TIMESTAMP('2023-01-01 10:00:01.234') AS timestamp, '{"temperature": 9999, "vibration": 5.0}' AS payload UNION ALL -- Outlier
  SELECT 'machine2' AS machine_id, TIMESTAMP('2023-01-01 11:00:01.789') AS timestamp, '{"temperature": 30.3, "vibration": 0.21}' AS payload
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT
  'machine1' AS machine_id, TIMESTAMP('2023-01-01 10:00:00') AS telemetry_timestamp, (25.5 + 25.7) / 2 AS temperature, (0.1 + 0.12) / 2 AS vibration
UNION ALL
SELECT
  'machine2' AS machine_id, TIMESTAMP('2023-01-01 11:00:00') AS telemetry_timestamp, 30.1 AS temperature, 0.2 AS vibration
UNION ALL
SELECT
  'machine2' AS machine_id, TIMESTAMP('2023-01-01 11:00:01') AS telemetry_timestamp, 30.3 AS temperature, 0.21 AS vibration