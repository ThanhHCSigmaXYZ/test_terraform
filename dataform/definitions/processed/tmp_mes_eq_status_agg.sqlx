config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "tmp_mes_eq_status_agg",
  tags: ["processed"],
  description: "設備状態ログからの稼働・停止時間算出",
  dataformCore: "3.0.7",
  partitionBy: "status_date",
  clusterBy: ["equipment_id"]
}

WITH normalized_status AS (
  -- Step1: Normalize error codes, etc.
  -- This is a placeholder for actual normalization logic.
  SELECT
    status_log_id,
    equipment_id,
    status_code,
    SAFE_CAST(status_changed_at AS TIMESTAMP) as status_changed_at,
    DATE(SAFE_CAST(status_changed_at AS TIMESTAMP)) as status_date
  FROM
    ${ref("raw_mes_eq_status")}
),
lagged_status AS (
  -- Step2: Get previous status change time
  SELECT
    *,
    COALESCE(
      LAG(status_changed_at, 1) OVER (PARTITION BY equipment_id ORDER BY status_changed_at),
      status_changed_at
    ) as prev_status_changed_at
  FROM
    normalized_status
)
-- Step3: Calculate duration
SELECT
  status_log_id,
  equipment_id,
  status_code,
  status_changed_at,
  status_date,
  TIMESTAMP_DIFF(status_changed_at, prev_status_changed_at, SECOND) AS duration_sec
FROM
  lagged_status
