config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "tmp_mes_eq_status_agg",
  bigquery: {
    partitionBy: "status_date",
    clusterBy: ["equipment_id"]
  }
}

-- This table aggregates equipment status data to calculate the duration of each status.
-- Processing steps:
-- 1. Normalizes error codes across different factories (using a CASE statement as an example).
-- 2. Uses the LAG window function to find the previous status change time for each equipment.
-- 3. Calculates the duration in seconds between status changes.

WITH
status_with_lag AS (
  SELECT
    status_log_id,
    equipment_id,
    status_code,
    status_changed_at,
    -- Step2(順序付): LAG関数を用い、同一設備(equipment_id)の「1つ前のステータス変化時刻」を取得
    LAG(status_changed_at, 1) OVER (PARTITION BY equipment_id ORDER BY status_changed_at) as prev_status_changed_at,
    DATE(status_changed_at) as status_date
  FROM ${ref("raw_mes_eq_status")}
)
SELECT
  status_log_id,
  equipment_id,
  -- Step1(正規化): エラーコードの工場間の体系差異を変換し統一 (Placeholder logic)
  CASE
    WHEN status_code = 'ERR_A' THEN 'UNIFIED_ERROR'
    WHEN status_code = 'ERR_B' THEN 'UNIFIED_ERROR'
    ELSE status_code
  END as status_code,
  status_changed_at,
  status_date,
  -- Step3(算出): 現在の時刻とStep2の時刻の差分から「継続時間(秒)」を算出しカラムを追加
  TIMESTAMP_DIFF(status_changed_at, prev_status_changed_at, SECOND) as duration_sec
FROM status_with_lag
