-- NOTE: expected output derived from mock data — verify if transformation logic changes
config {
  type: "test",
  dataset: "tmp_erp_mat_master_scd2"
}

input "raw_erp_mat_master" {
  SELECT 'mat1' AS material_id, 'Material A' AS material_name, 'kg' AS base_unit UNION ALL
  SELECT 'mat2' AS material_id, 'Material B' AS material_name, 'piece' AS base_unit UNION ALL
  SELECT 'mat3' AS material_id, 'Material C' AS material_name, 'liter' AS base_unit UNION ALL
  SELECT 'mat4' AS material_id, 'Material D' AS material_name, 'kg' AS base_unit UNION ALL
  SELECT 'mat5' AS material_id, 'Material E' AS material_name, 'piece' AS base_unit
}

SELECT 'mat1' AS material_id, 'Material A' AS material_name, 'kg' AS base_unit, CURRENT_DATE() as valid_from, DATE('9999-12-31') as valid_to, TRUE as is_current UNION ALL
SELECT 'mat2' AS material_id, 'Material B' AS material_name, 'piece' AS base_unit, CURRENT_DATE() as valid_from, DATE('9999-12-31') as valid_to, TRUE as is_current UNION ALL
SELECT 'mat3' AS material_id, 'Material C' AS material_name, 'liter' AS base_unit, CURRENT_DATE() as valid_from, DATE('9999-12-31') as valid_to, TRUE as is_current UNION ALL
SELECT 'mat4' AS material_id, 'Material D' AS material_name, 'kg' AS base_unit, CURRENT_DATE() as valid_from, DATE('9999-12-31') as valid_to, TRUE as is_current UNION ALL
SELECT 'mat5' AS material_id, 'Material E' AS material_name, 'piece' AS base_unit, CURRENT_DATE() as valid_from, DATE('9999-12-31') as valid_to, TRUE as is_current
