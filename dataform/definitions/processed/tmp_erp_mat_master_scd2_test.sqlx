config {
  type: "test",
  dataset: "tmp_erp_mat_master_scd2",
  name: "tmp_erp_mat_master_scd2_test"
}

input "raw_erp_mat_master" {
  SELECT 'mat1' AS material_id, 'Old Name' AS material_name, TIMESTAMP('2023-01-01 10:00:00') as etl_loaded_at UNION ALL
  SELECT 'mat1' AS material_id, 'New Name' AS material_name, TIMESTAMP('2023-01-15 10:00:00') as etl_loaded_at UNION ALL
  SELECT 'mat2' AS material_id, 'Material 2' AS material_name, TIMESTAMP('2023-01-02 10:00:00') as etl_loaded_at UNION ALL
  SELECT 'mat1' AS material_id, 'Newest Name' AS material_name, TIMESTAMP('2023-02-01 10:00:00') as etl_loaded_at UNION ALL
  SELECT 'mat2' AS material_id, 'Material 2 Updated' AS material_name, TIMESTAMP('2023-02-20 10:00:00') as etl_loaded_at
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT
  'mat1' AS material_id, 'Old Name' AS material_name, TIMESTAMP('2023-01-01 10:00:00') AS valid_from, TIMESTAMP('2023-01-15 10:00:00') AS valid_to, false AS is_current UNION ALL
  SELECT 'mat1' AS material_id, 'New Name' AS material_name, TIMESTAMP('2023-01-15 10:00:00') AS valid_from, TIMESTAMP('2023-02-01 10:00:00') AS valid_to, false AS is_current UNION ALL
  SELECT 'mat1' AS material_id, 'Newest Name' AS material_name, TIMESTAMP('2023-02-01 10:00:00') AS valid_from, TIMESTAMP('9999-12-31 23:59:59') AS valid_to, true AS is_current UNION ALL
  SELECT 'mat2' AS material_id, 'Material 2' AS material_name, TIMESTAMP('2023-01-02 10:00:00') AS valid_from, TIMESTAMP('2023-02-20 10:00:00') AS valid_to, false AS is_current UNION ALL
  SELECT 'mat2' AS material_id, 'Material 2 Updated' AS material_name, TIMESTAMP('2023-02-20 10:00:00') AS valid_from, TIMESTAMP('9999-12-31 23:59:59') AS valid_to, true AS is_current
