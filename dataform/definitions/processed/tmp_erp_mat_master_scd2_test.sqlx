config {
  type: "test",
  dataset: "tmp_erp_mat_master_scd2"
}

-- This is a simplified test for SCD2 logic due to framework constraints.
-- It only tests the initial load scenario.
input "raw_erp_mat_master" {
  SELECT 'mat1' AS material_id, 'Material 1 Original' AS material_name, TIMESTAMP('2023-01-01 10:00:00') as etl_loaded_at UNION ALL
  SELECT 'mat2' AS material_id, 'Material 2' AS material_name, TIMESTAMP('2023-01-01 10:00:00') as etl_loaded_at UNION ALL
  SELECT 'mat1' AS material_id, 'Material 1 Updated' AS material_name, TIMESTAMP('2023-01-02 10:00:00') as etl_loaded_at
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
-- This expected output assumes an initial run (non-incremental).
SELECT
  'mat1' as material_id,
  'Material 1 Original' as material_name,
  TIMESTAMP('2023-01-01 10:00:00') as valid_from,
  TIMESTAMP('2023-01-02 10:00:00') as valid_to,
  false as is_current
UNION ALL
SELECT
  'mat1' as material_id,
  'Material 1 Updated' as material_name,
  TIMESTAMP('2023-01-02 10:00:00') as valid_from,
  TIMESTAMP('9999-12-31 23:59:59') as valid_to,
  true as is_current
UNION ALL
SELECT
  'mat2' as material_id,
  'Material 2' as material_name,
  TIMESTAMP('2023-01-01 10:00:00') as valid_from,
  TIMESTAMP('9999-12-31 23:59:59') as valid_to,
  true as is_current