-- NOTE: expected output derived from mock data — verify if transformation logic changes
config {
    type: "test",
    dataset: "tmp_erp_mat_master_scd2"
}

input "raw_erp_mat_master" {
    SELECT 'mat1' AS material_id, 'Material 1 v1' AS material_name, DATE('2023-01-01') AS etl_loaded_date UNION ALL
    SELECT 'mat2' AS material_id, 'Material 2 v1' AS material_name, DATE('2023-01-01') AS etl_loaded_date UNION ALL
    SELECT 'mat1' AS material_id, 'Material 1 v2' AS material_name, DATE('2023-01-02') AS etl_loaded_date UNION ALL
    SELECT 'mat3' AS material_id, 'Material 3 v1' AS material_name, DATE('2023-01-02') AS etl_loaded_date UNION ALL
    SELECT 'mat1' AS material_id, 'Material 1 v3' AS material_name, DATE('2023-01-03') AS etl_loaded_date UNION ALL
    SELECT 'mat2' AS material_id, 'Material 2 v1' AS material_name, DATE('2023-01-03') AS etl_loaded_date
}

-- Expected output after SCD2 logic
SELECT
    'mat1' AS material_id, 'Material 1 v1' AS material_name, DATE('2023-01-01') AS valid_from, DATE('2023-01-02') AS valid_to, false AS is_current
UNION ALL
SELECT
    'mat1' AS material_id, 'Material 1 v2' AS material_name, DATE('2023-01-02') AS valid_from, DATE('2023-01-03') AS valid_to, false AS is_current
UNION ALL
SELECT
    'mat1' AS material_id, 'Material 1 v3' AS material_name, DATE('2023-01-03') AS valid_from, DATE('9999-12-31') AS valid_to, true AS is_current
UNION ALL
SELECT
    'mat2' AS material_id, 'Material 2 v1' AS material_name, DATE('2023-01-01') AS valid_from, DATE('9999-12-31') AS valid_to, true AS is_current
UNION ALL
SELECT
    'mat3' AS material_id, 'Material 3 v1' AS material_name, DATE('2023-01-02') AS valid_from, DATE('9999-12-31') AS valid_to, true AS is_current
