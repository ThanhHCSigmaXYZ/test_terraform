config {
  type: "test",
  dataset: "tmp_erp_mat_master_scd2"
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes

input "raw_erp_mat_master" {
  -- mat1 has two versions
  SELECT 'mat1' as material_id, 'Material 1 - v1' as description, TIMESTAMP('2023-01-01 08:00:00') as etl_loaded_at UNION ALL
  SELECT 'mat1' as material_id, 'Material 1 - v2' as description, TIMESTAMP('2023-01-15 08:00:00') as etl_loaded_at UNION ALL
  -- mat2 has only one version
  SELECT 'mat2' as material_id, 'Material 2 - v1' as description, TIMESTAMP('2023-01-02 08:00:00') as etl_loaded_at UNION ALL
  -- mat3 has three versions
  SELECT 'mat3' as material_id, 'Material 3 - v1' as description, TIMESTAMP('2023-02-01 08:00:00') as etl_loaded_at UNION ALL
  SELECT 'mat3' as material_id, 'Material 3 - v2' as description, TIMESTAMP('2023-02-10 08:00:00') as etl_loaded_at UNION ALL
  SELECT 'mat3' as material_id, 'Material 3 - v3' as description, TIMESTAMP('2023-02-20 08:00:00') as etl_loaded_at

}

SELECT
  'mat1' as material_id, 'Material 1 - v1' as description, TIMESTAMP('2023-01-01 08:00:00') as valid_from, TIMESTAMP('2023-01-15 08:00:00') as valid_to, false as is_current
UNION ALL
SELECT
  'mat1' as material_id, 'Material 1 - v2' as description, TIMESTAMP('2023-01-15 08:00:00') as valid_from, TIMESTAMP('9999-12-31 23:59:59') as valid_to, true as is_current
UNION ALL
SELECT
  'mat2' as material_id, 'Material 2 - v1' as description, TIMESTAMP('2023-01-02 08:00:00') as valid_from, TIMESTAMP('9999-12-31 23:59:59') as valid_to, true as is_current
UNION ALL
SELECT
  'mat3' as material_id, 'Material 3 - v1' as description, TIMESTAMP('2023-02-01 08:00:00') as valid_from, TIMESTAMP('2023-02-10 08:00:00') as valid_to, false as is_current
UNION ALL
SELECT
  'mat3' as material_id, 'Material 3 - v2' as description, TIMESTAMP('2023-02-10 08:00:00') as valid_from, TIMESTAMP('2023-02-20 08:00:00') as valid_to, false as is_current
UNION ALL
SELECT
  'mat3' as material_id, 'Material 3 - v3' as description, TIMESTAMP('2023-02-20 08:00:00') as valid_from, TIMESTAMP('9999-12-31 23:59:59') as valid_to, true as is_current
