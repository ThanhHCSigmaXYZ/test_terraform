config {
  type: "incremental",
  schema: "dev_dataform_dataset",
  name: "tmp_erp_worker_master_scd2",
  tags: ["processed"],
  uniqueKey: ["worker_id", "valid_from"],
  bigquery: {
    clusterBy: ["worker_id"]
  }
}

-- Step 1: Union new/changed records with existing records
WITH all_records AS (
    SELECT
        worker_id,
        worker_name,
        etl_loaded_at,
        LEAD(etl_loaded_at, 1, TIMESTAMP('9999-12-31 23:59:59')) OVER (PARTITION BY worker_id ORDER BY etl_loaded_at) AS next_etl_loaded_at
    FROM ${ref("raw_erp_worker_master")}
    
    ${when(incremental(), `
        UNION ALL
        SELECT
            worker_id,
            worker_name,
            valid_from AS etl_loaded_at,
            TIMESTAMP_SUB(valid_to, INTERVAL 1 MICROSECOND) AS next_etl_loaded_at
        FROM ${self}
        WHERE is_current
    `)}
),
-- Step 2: Detect changes and set validity dates
changes AS (
    SELECT
        worker_id,
        worker_name,
        etl_loaded_at AS valid_from,
        next_etl_loaded_at AS valid_to,
        (ROW_NUMBER() OVER (PARTITION BY worker_id ORDER BY etl_loaded_at DESC) = 1) AS is_current
    FROM all_records
)
SELECT * FROM changes