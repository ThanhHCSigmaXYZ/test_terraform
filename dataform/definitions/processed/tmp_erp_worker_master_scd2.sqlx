config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "tmp_erp_worker_master_scd2",
  description: "作業者マスタのSCD Type2処理（履歴化）",
  tags: ["processed"],
  bigquery: {
    clusterBy: ["worker_id"]
  }
}

WITH changes AS (
  SELECT
    worker_id,
    worker_name, -- Assuming this is the attribute that changes
    etl_loaded_at,
    -- Create a hash of the attributes to detect changes
    TO_JSON_STRING(t) AS attr_hash
  FROM
    ${ref("raw_erp_worker_master")} AS t
),
lagged_changes AS (
  SELECT
    *,
    -- Get the hash of the previous record for the same worker
    LAG(attr_hash, 1) OVER (PARTITION BY worker_id ORDER BY etl_loaded_at) AS prev_attr_hash
  FROM changes
),
validity_periods AS (
  SELECT
    worker_id,
    worker_name,
    etl_loaded_at AS valid_from,
    -- The record is valid until the next change occurs
    LEAD(etl_loaded_at, 1, CAST('9999-12-31 23:59:59' AS TIMESTAMP)) OVER (PARTITION BY worker_id ORDER BY etl_loaded_at) AS valid_to
  FROM lagged_changes
  -- A new record starts when the hash is different from the previous one
  WHERE prev_attr_hash IS NULL OR prev_attr_hash != attr_hash
)
SELECT
  *,
  -- The current record is the one with the far-future valid_to date
  (valid_to = CAST('9999-12-31 23:59:59' AS TIMESTAMP)) AS is_current
FROM validity_periods
