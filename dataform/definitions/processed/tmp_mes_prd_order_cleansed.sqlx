config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "tmp_mes_prd_order_cleansed",
  description: "MES製造実績のクレンジングと型変換",
  tags: ["processed"],
  bigquery: {
    partitionBy: "production_date",
    clusterBy: ["product_serial_no"]
  }
}

-- Note: Full-width to half-width normalization is not implemented as there is no standard BigQuery function.
-- A UDF would be required for this transformation.

SELECT
  order_id,
  product_serial_no,
  CAST(start_time_str AS TIMESTAMP) AS start_time,
  CAST(end_time_str AS TIMESTAMP) AS end_time,
  DATE(CAST(start_time_str AS TIMESTAMP)) as production_date,
  IFNULL(work_memo, '') AS work_memo
FROM
  ${ref("raw_mes_prd_order")}
