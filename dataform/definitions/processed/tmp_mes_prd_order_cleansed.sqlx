config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "tmp_mes_prd_order_cleansed",
  tags: ["processed"],
  description: "MES製造実績のクレンジングと型変換",
  dataformCore: "3.0.7",
  partitionBy: "production_date",
  clusterBy: ["product_serial_no"]
}

WITH base AS (
  SELECT
    *
  FROM
    ${ref("raw_mes_prd_order")}
)
SELECT
  order_id,
  product_serial_no,
  material_id,
  worker_id,
  equipment_id, -- Added this column
  SAFE_CAST(start_time_str AS TIMESTAMP) AS start_time,
  SAFE_CAST(end_time_str AS TIMESTAMP) AS end_time,
  COALESCE(work_memo, '') AS work_memo,
  DATE(SAFE_CAST(start_time_str AS TIMESTAMP)) as production_date
  -- other columns
FROM base
-- Note: Simplified version of normalization and casting.
-- Real implementation may need more robust error handling and normalization logic.
