config {
  type: "test",
  dataset: "tmp_mes_prd_order_cleansed"
}

input "raw_mes_prd_order" {
  SELECT 'order1' as order_id, 'psn1' as product_serial_no, '2026-03-17 10:00:00' as start_time_str, '2026-03-17 11:00:00' as end_time_str, 'memo1' as work_memo UNION ALL
  SELECT 'order2' as order_id, 'psn2' as product_serial_no, '2026-03-17 12:00:00' as start_time_str, '2026-03-17 13:00:00' as end_time_str, NULL as work_memo UNION ALL
  SELECT 'order3' as order_id, 'psn3' as product_serial_no, '2026-03-18 09:00:00' as start_time_str, '2026-03-18 10:30:00' as end_time_str, 'memo3' as work_memo UNION ALL
  SELECT 'order4' as order_id, 'psn4' as product_serial_no, '2026-03-18 11:00:00' as start_time_str, '2026-03-18 12:00:00' as end_time_str, NULL as work_memo UNION ALL
  SELECT 'order5' as order_id, 'psn5' as product_serial_no, '2026-03-19 10:00:00' as start_time_str, '2026-03-19 11:00:00' as end_time_str, 'memo5' as work_memo
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
expected {
  SELECT 'order1' AS order_id, 'psn1' AS product_serial_no, CAST('2026-03-17 10:00:00' AS TIMESTAMP) AS start_time, CAST('2026-03-17 11:00:00' AS TIMESTAMP) AS end_time, DATE '2026-03-17' AS production_date, 'memo1' as work_memo UNION ALL
  SELECT 'order2' AS order_id, 'psn2' AS product_serial_no, CAST('2026-03-17 12:00:00' AS TIMESTAMP) AS start_time, CAST('2026-03-17 13:00:00' AS TIMESTAMP) AS end_time, DATE '2026-03-17' AS production_date, '' as work_memo UNION ALL
  SELECT 'order3' AS order_id, 'psn3' AS product_serial_no, CAST('2026-03-18 09:00:00' AS TIMESTAMP) AS start_time, CAST('2026-03-18 10:30:00' AS TIMESTAMP) AS end_time, DATE '2026-03-18' AS production_date, 'memo3' as work_memo UNION ALL
  SELECT 'order4' AS order_id, 'psn4' AS product_serial_no, CAST('2026-03-18 11:00:00' AS TIMESTAMP) AS start_time, CAST('2026-03-18 12:00:00' AS TIMESTAMP) AS end_time, DATE '2026-03-18' AS production_date, '' as work_memo UNION ALL
  SELECT 'order5' AS order_id, 'psn5' AS product_serial_no, CAST('2026-03-19 10:00:00' AS TIMESTAMP) AS start_time, CAST('2026-03-19 11:00:00' AS TIMESTAMP) AS end_time, DATE '2026-03-19' AS production_date, 'memo5' as work_memo
}
