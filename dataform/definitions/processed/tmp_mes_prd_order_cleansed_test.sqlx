config {
  type: "test",
  dataset: "tmp_mes_prd_order_cleansed"
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes

input "raw_mes_prd_order" {
  SELECT 'o1' as order_id, 'psn1' as product_serial_no, '2023-01-01T10:00:00Z' as start_time, '2023-01-01T11:00:00Z' as end_time, 'Notes １' as order_notes, 'Memo 1' as work_memo, DATE '2023-01-01' as production_date UNION ALL
  SELECT 'o2' as order_id, 'psn2' as product_serial_no, '2023-01-01T12:00:00Z' as start_time, '2023-01-01T13:00:00Z' as end_time, 'Notes ２' as order_notes, NULL as work_memo, DATE '2023-01-01' as production_date UNION ALL
  SELECT 'o3' as order_id, 'psn3' as product_serial_no, '2023-01-02T10:00:00Z' as start_time, '2023-01-02T11:00:00Z' as end_time, 'Notes ３' as order_notes, 'Memo 3' as work_memo, DATE '2023-01-02' as production_date UNION ALL
  SELECT 'o4' as order_id, 'psn4' as product_serial_no, '2023-01-02T12:00:00Z' as start_time, '2023-01-02T13:00:00Z' as end_time, 'Notes ４' as order_notes, NULL as work_memo, DATE '2023-01-02' as production_date UNION ALL
  SELECT 'o5' as order_id, 'psn5' as product_serial_no, '2023-01-03T10:00:00Z' as start_time, '2023-01-03T11:00:00Z' as end_time, 'Notes ５' as order_notes, 'Memo 5' as work_memo, DATE '2023-01-03' as production_date
}

SELECT
  'o1' as order_id, 'psn1' as product_serial_no, TIMESTAMP('2023-01-01T10:00:00Z') as start_time, TIMESTAMP('2023-01-01T11:00:00Z') as end_time, 'Notes １' as order_notes, 'Memo 1' as work_memo, DATE '2023-01-01' as production_date UNION ALL
  'o2' as order_id, 'psn2' as product_serial_no, TIMESTAMP('2023-01-01T12:00:00Z') as start_time, TIMESTAMP('2023-01-01T13:00:00Z') as end_time, 'Notes ２' as order_notes, '' as work_memo, DATE '2023-01-01' as production_date UNION ALL
  'o3' as order_id, 'psn3' as product_serial_no, TIMESTAMP('2023-01-02T10:00:00Z') as start_time, TIMESTAMP('2023-01-02T11:00:00Z') as end_time, 'Notes ３' as order_notes, 'Memo 3' as work_memo, DATE '2023-01-02' as production_date UNION ALL
  'o4' as order_id, 'psn4' as product_serial_no, TIMESTAMP('2023-01-02T12:00:00Z') as start_time, TIMESTAMP('2023-01-02T13:00:00Z') as end_time, 'Notes ４' as order_notes, '' as work_memo, DATE '2023-01-02' as production_date UNION ALL
  'o5' as order_id, 'psn5' as product_serial_no, TIMESTAMP('2023-01-03T10:00:00Z') as start_time, TIMESTAMP('2023-01-03T11:00:00Z') as end_time, 'Notes ５' as order_notes, 'Memo 5' as work_memo, DATE '2023-01-03' as production_date
