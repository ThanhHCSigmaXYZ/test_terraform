config {
  type: "test",
  dataset: "tmp_qms_inspection_std"
}

input "raw_qms_inspection" {
  SELECT 'insp1' AS inspection_id, 'serial1' AS product_serial_no, '2023-01-10' AS inspection_date_str, '10.5' as inspection_value_str, 'mm' as inspection_unit UNION ALL
  SELECT 'insp2' AS inspection_id, 'serial2' AS product_serial_no, '2023-01-11' AS inspection_date_str, '1.2' as inspection_value_str, 'cm' as inspection_unit UNION ALL
  SELECT 'insp3' AS inspection_id, 'serial3' AS product_serial_no, '2023-01-11' AS inspection_date_str, '0.05' as inspection_value_str, 'm' as inspection_unit UNION ALL
  SELECT 'insp4' AS inspection_id, 'serial4' AS product_serial_no, '2023-01-12' AS inspection_date_str, '22.3' as inspection_value_str, 'mm' as inspection_unit UNION ALL
  SELECT 'insp5' AS inspection_id, 'serial5' AS product_serial_no, 'invalid-date' AS inspection_date_str, '5.0' as inspection_value_str, 'mm' as inspection_unit
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT
  'insp1' AS inspection_id, 'serial1' AS product_serial_no, DATE('2023-01-10') AS inspection_date, 10.5 AS inspection_value, 10.5 AS inspection_value_mm
UNION ALL
SELECT
  'insp2' AS inspection_id, 'serial2' AS product_serial_no, DATE('2023-01-11') AS inspection_date, 1.2 AS inspection_value, 12.0 AS inspection_value_mm
UNION ALL
SELECT
  'insp3' AS inspection_id, 'serial3' AS product_serial_no, DATE('2023-01-11') AS inspection_date, 0.05 AS inspection_value, 50.0 AS inspection_value_mm
UNION ALL
SELECT
  'insp4' AS inspection_id, 'serial4' AS product_serial_no, DATE('2023-01-12') AS inspection_date, 22.3 AS inspection_value, 22.3 AS inspection_value_mm