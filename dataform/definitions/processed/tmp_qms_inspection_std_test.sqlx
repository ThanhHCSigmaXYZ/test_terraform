config {
  type: "test",
  dataset: "tmp_qms_inspection_std"
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes

input "raw_qms_inspection" {
  SELECT 'insp1' as inspection_id, 'psn1' as product_serial_no, '2023-01-10' as inspection_date, 'inspectorA' as inspector, '100' as measurement_value, 'mm' as measurement_unit UNION ALL
  SELECT 'insp2' as inspection_id, 'psn1' as product_serial_no, '2023-01-11' as inspection_date, 'inspectorB' as inspector, '12' as measurement_value, 'cm' as measurement_unit UNION ALL
  SELECT 'insp3' as inspection_id, 'psn2' as product_serial_no, '2023-01-12' as inspection_date, 'inspectorA' as inspector, '250' as measurement_value, 'mm' as measurement_unit UNION ALL
  SELECT 'insp4' as inspection_id, 'psn3' as product_serial_no, '2023-01-13' as inspection_date, 'inspectorC' as inspector, '30' as measurement_value, 'cm' as measurement_unit UNION ALL
  SELECT 'insp5' as inspection_id, 'psn3' as product_serial_no, '2023-01-14' as inspection_date, 'inspectorB' as inspector, '500' as measurement_value, 'mm' as measurement_unit
}

SELECT
  'insp1' as inspection_id, 'psn1' as product_serial_no, DATE('2023-01-10') as inspection_date, 'inspectorA' as inspector, 10.0 as measurement_value_cm UNION ALL
  'insp2' as inspection_id, 'psn1' as product_serial_no, DATE('2023-01-11') as inspection_date, 'inspectorB' as inspector, 12.0 as measurement_value_cm UNION ALL
  'insp3' as inspection_id, 'psn2' as product_serial_no, DATE('2023-01-12') as inspection_date, 'inspectorA' as inspector, 25.0 as measurement_value_cm UNION ALL
  'insp4' as inspection_id, 'psn3' as product_serial_no, DATE('2023-01-13') as inspection_date, 'inspectorC' as inspector, 30.0 as measurement_value_cm UNION ALL
  'insp5' as inspection_id, 'psn3' as product_serial_no, DATE('2023-01-14') as inspection_date, 'inspectorB' as inspector, 50.0 as measurement_value_cm
