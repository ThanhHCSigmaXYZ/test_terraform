config {
  type: "test",
  dataset: "tmp_qms_inspection_std",
  name: "tmp_qms_inspection_std_test"
}

input "raw_qms_inspection" {
  SELECT 'insp1' as inspection_id, 's1' as product_serial_no, '2023-01-12' as inspection_date_str, '1.5' as measurement_cm, 'PASS' as result UNION ALL
  SELECT 'insp2' as inspection_id, 's2' as product_serial_no, '2023-01-12' as inspection_date_str, '2.0' as measurement_cm, 'FAIL' as result UNION ALL
  SELECT 'insp3' as inspection_id, 's3' as product_serial_no, '2023-01-13' as inspection_date_str, '3.1' as measurement_cm, 'PASS' as result UNION ALL
  SELECT 'insp4' as inspection_id, 's4' as product_serial_no, '2023-01-14' as inspection_date_str, '4.2' as measurement_cm, 'PASS' as result UNION ALL
  SELECT 'insp5' as inspection_id, 's5' as product_serial_no, '2023-01-14' as inspection_date_str, '5.0' as measurement_cm, 'FAIL' as result
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT
  'insp1' as inspection_id, 's1' as product_serial_no, DATE('2023-01-12') as inspection_date, 15.0 as measurement_mm, 'PASS' as result UNION ALL
  SELECT 'insp2' as inspection_id, 's2' as product_serial_no, DATE('2023-01-12') as inspection_date, 20.0 as measurement_mm, 'FAIL' as result UNION ALL
  SELECT 'insp3' as inspection_id, 's3' as product_serial_no, DATE('2023-01-13') as inspection_date, 31.0 as measurement_mm, 'PASS' as result UNION ALL
  SELECT 'insp4' as inspection_id, 's4' as product_serial_no, DATE('2023-01-14') as inspection_date, 42.0 as measurement_mm, 'PASS' as result UNION ALL
  SELECT 'insp5' as inspection_id, 's5' as product_serial_no, DATE('2023-01-14') as inspection_date, 50.0 as measurement_mm, 'FAIL' as result
