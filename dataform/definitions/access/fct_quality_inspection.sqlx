config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "fct_quality_inspection",
  tags: ["access", "fact"],
  bigquery: {
    partitionBy: "inspection_date",
    clusterBy: ["product_serial_no"]
  }
}

SELECT
  insp.inspection_id,
  insp.product_serial_no,
  insp.inspection_date,
  insp.inspection_value_mm,
  -- Joining with production performance to add context
  perf.order_id,
  perf.material_id,
  perf.worker_id,
  perf.production_lead_time_sec
FROM
  ${ref("tmp_qms_inspection_std")} AS insp
LEFT JOIN
  ${ref("fct_production_performance")} AS perf
  ON insp.product_serial_no = perf.product_serial_no