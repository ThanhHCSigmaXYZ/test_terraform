config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "fct_quality_inspection",
  tags: ["access"],
  description: "品質分析用のファクトテーブル作成",
  dataformCore: "3.0.7",
  partitionBy: "inspection_date",
  clusterBy: ["product_serial_no"]
}

SELECT
  q.inspection_id,
  q.product_serial_no,
  q.inspection_date,
  p.order_id,
  p.worker_id,
  p.material_id,
  p.production_lead_time_sec
FROM
  ${ref("tmp_qms_inspection_std")} q
LEFT JOIN
  ${ref("fct_production_performance")} p ON q.product_serial_no = p.product_serial_no
