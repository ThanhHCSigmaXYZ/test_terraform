config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "fct_quality_inspection",
  description: "品質分析用のファクトテーブル",
  tags: ["access", "fact"],
  bigquery: {
    partitionBy: "inspection_date",
    clusterBy: ["product_serial_no"]
  }
}

SELECT
  qual.*,
  -- Select specific context from production, avoiding duplicated columns
  prod.order_id,
  prod.material_id,
  prod.worker_id,
  prod.start_time AS production_start_time,
  prod.end_time AS production_end_time,
  prod.production_lead_time_sec,
  prod.material_name,
  prod.worker_name
FROM
  ${ref("tmp_qms_inspection_std")} AS qual
LEFT JOIN
  ${ref("fct_production_performance")} AS prod
  ON qual.product_serial_no = prod.product_serial_no
