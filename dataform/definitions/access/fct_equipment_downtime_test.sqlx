config {
  type: "test",
  dataset: "fct_equipment_downtime"
}

-- NOTE: mock data designed for deterministic JOIN results
input "tmp_mes_eq_status_agg" {
  -- This status occurs during the production of order1
  SELECT 'log1' as status_log_id, 'eq1' as equipment_id, 'DOWN' as status_code, 300 as duration_sec, DATE('2023-01-01') as status_date, TIMESTAMP('2023-01-01 10:30:00') as status_changed_at UNION ALL
  -- This status occurs outside any production time
  SELECT 'log2' as status_log_id, 'eq1' as equipment_id, 'IDLE' as status_code, 600 as duration_sec, DATE('2023-01-01') as status_date, TIMESTAMP('2023-01-01 12:00:00') as status_changed_at
}

input "fct_production_performance" {
  SELECT 'order1' as order_id, 'eq1' as equipment_id, TIMESTAMP('2023-01-01 10:00:00') as start_time, TIMESTAMP('2023-01-01 11:00:00') as end_time
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
-- NOTE: status_changed_at is designed to fall between start_time and end_time for the successful join case
SELECT
  'log1' as status_log_id,
  'eq1' as equipment_id,
  'DOWN' as status_code,
  300 as duration_sec,
  DATE('2023-01-01') as status_date,
  'order1' as order_id
UNION ALL
SELECT
  'log2' as status_log_id,
  'eq1' as equipment_id,
  'IDLE' as status_code,
  600 as duration_sec,
  DATE('2023-01-01') as status_date,
  NULL as order_id