config {
  type: "test",
  dataset: "fct_equipment_downtime"
}
-- NOTE: mock data designed for deterministic JOIN results
input "tmp_mes_eq_status_agg" {
  SELECT 1 as status_log_id, 'eq1' as equipment_id, 'STOPPED' as status_code, 600 as duration_sec, TIMESTAMP('2023-01-01 10:30:00') as status_changed_at, DATE('2023-01-01') as status_date UNION ALL
  SELECT 2 as status_log_id, 'eq2' as equipment_id, 'ERROR' as status_code, 300 as duration_sec, TIMESTAMP('2023-01-01 12:30:00') as status_changed_at, DATE('2023-01-01') as status_date
}
input "fct_production_performance" {
  -- NOTE: [timestamp_col] is designed to fall between [start_col] and [end_col]
  SELECT 'o1' as order_id, 'eq1' as equipment_id, TIMESTAMP('2023-01-01 10:00:00') as start_time, TIMESTAMP('2023-01-01 11:00:00') as end_time UNION ALL
  SELECT 'o2' as order_id, 'eq2' as equipment_id, TIMESTAMP('2023-01-01 12:00:00') as start_time, TIMESTAMP('2023-01-01 13:00:00') as end_time
}

SELECT
  1 as status_log_id, 'eq1' as equipment_id, 'STOPPED' as status_code, 600 as duration_sec, DATE('2023-01-01') as status_date, 'o1' as order_id
UNION ALL
SELECT
  2 as status_log_id, 'eq2' as equipment_id, 'ERROR' as status_code, 300 as duration_sec, DATE('2023-01-01') as status_date, 'o2' as order_id
