-- NOTE: mock data designed for deterministic JOIN results
config {
    type: "test",
    dataset: "fct_equipment_downtime"
}

input {
    name: "tmp_mes_eq_status_agg",
    data: [
        -- Downtime event for eq1
        {status_log_id: "log1", equipment_id: "eq1", status_code: "STOP", status_changed_at: TIMESTAMP("2023-01-01 10:30:00"), duration_sec: 600, status_date: DATE("2023-01-01")},
        -- Event outside of any production order
        {status_log_id: "log2", equipment_id: "eq1", status_code: "IDLE", status_changed_at: TIMESTAMP("2023-01-01 12:00:00"), duration_sec: 3600, status_date: DATE("2023-01-01")},
        -- Downtime event for eq2
        {status_log_id: "log3", equipment_id: "eq2", status_code: "ERROR", status_changed_at: TIMESTAMP("2023-01-02 14:15:00"), duration_sec: 300, status_date: DATE("2023-01-02")}
    ]
}
input {
    name: "fct_production_performance",
    data: [
        -- NOTE: equipment_id added to mock data for the join
        {order_id: "order1", product_serial_no: "serial1", equipment_id: "eq1", start_time: TIMESTAMP("2023-01-01 10:00:00"), end_time: TIMESTAMP("2023-01-01 11:00:00")},
        {order_id: "order2", product_serial_no: "serial2", equipment_id: "eq2", start_time: TIMESTAMP("2023-01-02 14:00:00"), end_time: TIMESTAMP("2023-01-02 15:00:00")}
    ]
}

-- Expected output: log1 and log3 should be linked to an order, log2 should not
SELECT
    "log1" as status_log_id, "eq1" as equipment_id, "STOP" as status_code, TIMESTAMP("2023-01-01 10:30:00") as status_changed_at, 600 as duration_sec, DATE("2023-01-01") as status_date, "order1" as order_id, "serial1" as product_serial_no
UNION ALL
SELECT
    "log2" as status_log_id, "eq1" as equipment_id, "IDLE" as status_code, TIMESTAMP("2023-01-01 12:00:00") as status_changed_at, 3600 as duration_sec, DATE("2023-01-01") as status_date, NULL as order_id, NULL as product_serial_no
UNION ALL
SELECT
    "log3" as status_log_id, "eq2" as equipment_id, "ERROR" as status_code, TIMESTAMP("2023-01-02 14:15:00") as status_changed_at, 300 as duration_sec, DATE("2023-01-02") as status_date, "order2" as order_id, "serial2" as product_serial_no
