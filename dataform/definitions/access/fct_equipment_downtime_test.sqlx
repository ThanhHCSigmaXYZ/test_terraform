-- NOTE: mock data designed for deterministic JOIN results
config {
  type: "test",
  dataset: "fct_equipment_downtime"
}

input "tmp_mes_eq_status_agg" {
  -- NOTE: [timestamp_col] is designed to fall between [start_col] and [end_col]
  SELECT 1 AS status_log_id, 'EQ-1' AS equipment_id, 'STOPPED' AS status_code, 600 AS duration_sec, TIMESTAMP('2023-01-01 10:30:00') AS status_changed_at, DATE('2023-01-01') AS status_date UNION ALL
  SELECT 2 AS status_log_id, 'EQ-2' AS equipment_id, 'STOPPED' AS status_code, 300 AS duration_sec, TIMESTAMP('2023-01-02 12:00:00') AS status_changed_at, DATE('2023-01-02') AS status_date
}

input "fct_production_performance" {
  SELECT 101 AS order_id, 'EQ-1' AS equipment_id, TIMESTAMP('2023-01-01 10:00:00') AS start_time, TIMESTAMP('2023-01-01 11:00:00') AS end_time UNION ALL
  SELECT 102 AS order_id, 'EQ-2' AS equipment_id, TIMESTAMP('2023-01-02 11:00:00') AS start_time, TIMESTAMP('2023-01-02 12:00:00') AS end_time
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT 1 AS status_log_id, 'EQ-1' AS equipment_id, 'STOPPED' AS status_code, 600 AS duration_sec, 101 AS order_id, DATE('2023-01-01') AS status_date UNION ALL
SELECT 2 AS status_log_id, 'EQ-2' AS equipment_id, 'STOPPED' AS status_code, 300 AS duration_sec, NULL AS order_id, DATE('2023-01-02') AS status_date
