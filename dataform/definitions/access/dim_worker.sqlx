config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "dim_worker",
  tags: ["access", "dimension"]
}

SELECT
  worker_id,
  -- In a real scenario, personal information like names would be hashed or anonymized
  -- in the processed layer. This is a direct pass-through for demonstration.
  worker_name
FROM
  ${ref("tmp_erp_worker_master_scd2")}
WHERE
  is_current