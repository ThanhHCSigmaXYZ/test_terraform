config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "fct_equipment_downtime",
  bigquery: {
    partitionBy: "status_date",
    clusterBy: ["equipment_id", "status_code"]
  }
}

-- This fact table identifies which product was being worked on during an equipment downtime event.
SELECT
  downtime.status_log_id,
  downtime.equipment_id,
  downtime.status_code,
  downtime.duration_sec,
  downtime.status_date,
  prod.order_id
FROM ${ref("tmp_mes_eq_status_agg")} AS downtime
LEFT JOIN ${ref("fct_production_performance")} AS prod
  ON downtime.equipment_id = prod.equipment_id
  -- Non-equi JOIN to find the production order active during the status change
  AND downtime.status_changed_at BETWEEN prod.start_time AND prod.end_time
