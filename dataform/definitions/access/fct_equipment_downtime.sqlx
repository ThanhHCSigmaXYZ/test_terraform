config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "fct_equipment_downtime",
  description: "設備停止分析用のファクトテーブル",
  tags: ["access", "fact"],
  bigquery: {
    partitionBy: "status_date",
    clusterBy: ["equipment_id", "status_code"]
  }
}

SELECT
  downtime.*,
  prod.order_id,
  prod.product_serial_no
FROM
  ${ref("tmp_mes_eq_status_agg")} AS downtime
LEFT JOIN
  ${ref("fct_production_performance")} AS prod
  ON downtime.equipment_id = prod.equipment_id -- Assuming equipment_id exists in fct_production_performance
  AND downtime.status_changed_at BETWEEN prod.start_time AND prod.end_time
