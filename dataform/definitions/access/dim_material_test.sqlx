config {
  type: "test",
  dataset: "dim_material"
}

-- NOTE: mock data designed for deterministic JOIN results
input "tmp_erp_mat_master_scd2" {
  SELECT 'mat1' as material_id, 'v1' as description, false as is_current UNION ALL
  SELECT 'mat1' as material_id, 'v2' as description, true as is_current UNION ALL
  SELECT 'mat2' as material_id, 'v1' as description, true as is_current
}

SELECT
  'mat1' as material_id, 'v2' as description
UNION ALL
SELECT
  'mat2' as material_id, 'v1' as description
