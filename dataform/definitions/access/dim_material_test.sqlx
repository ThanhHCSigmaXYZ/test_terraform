-- NOTE: mock data designed for deterministic JOIN results
config {
  type: "test",
  dataset: "dim_material"
}

input "tmp_erp_mat_master_scd2" {
  SELECT 'mat1' AS material_id, 'Material A' AS material_name, 'kg' AS base_unit, TRUE AS is_current UNION ALL
  SELECT 'mat2' AS material_id, 'Old Material B' AS material_name, 'piece' AS base_unit, FALSE AS is_current UNION ALL
  SELECT 'mat2' AS material_id, 'New Material B' AS material_name, 'piece' AS base_unit, TRUE AS is_current UNION ALL
  SELECT 'mat3' AS material_id, 'Material C' AS material_name, 'liter' AS base_unit, TRUE AS is_current UNION ALL
  SELECT 'mat4' AS material_id, 'Material D' AS material_name, 'kg' AS base_unit, TRUE AS is_current
}

SELECT 'mat1' AS material_id, 'Material A' AS material_name, 'kg' AS base_unit UNION ALL
SELECT 'mat2' AS material_id, 'New Material B' AS material_name, 'piece' AS base_unit UNION ALL
SELECT 'mat3' AS material_id, 'Material C' AS material_name, 'liter' AS base_unit UNION ALL
SELECT 'mat4' AS material_id, 'Material D' AS material_name, 'kg' AS base_unit
