config {
  type: "test",
  dataset: "dim_material"
}

-- NOTE: mock data designed for deterministic JOIN results
input "tmp_erp_mat_master_scd2" {
  SELECT 'mat1' as material_id, 'Material 1 Old' as material_name, false as is_current UNION ALL
  SELECT 'mat1' as material_id, 'Material 1 Current' as material_name, true as is_current UNION ALL
  SELECT 'mat2' as material_id, 'Material 2' as material_name, true as is_current UNION ALL
  SELECT 'mat3' as material_id, 'Material 3' as material_name, true as is_current UNION ALL
  SELECT 'mat4' as material_id, 'Material 4' as material_name, true as is_current
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT
  'mat1' as material_id,
  'Material 1 Current' as material_name
UNION ALL
SELECT
  'mat2' as material_id,
  'Material 2' as material_name
UNION ALL
SELECT
  'mat3' as material_id,
  'Material 3' as material_name
UNION ALL
SELECT
  'mat4' as material_id,
  'Material 4' as material_name