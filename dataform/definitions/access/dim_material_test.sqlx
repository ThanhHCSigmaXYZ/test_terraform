-- NOTE: mock data designed for deterministic JOIN results
config {
  type: "test",
  dataset: "dim_material"
}

input "tmp_erp_mat_master_scd2" {
  -- mat1: only the last record is current
  SELECT 'mat1' as material_id, 'Steel' as material_name, CAST('2026-01-15 10:00:00' AS TIMESTAMP) as valid_from, CAST('2026-02-20 10:00:00' AS TIMESTAMP) as valid_to, false as is_current UNION ALL
  SELECT 'mat1' as material_id, 'Stainless Steel' as material_name, CAST('2026-02-20 10:00:00' AS TIMESTAMP) as valid_from, CAST('9999-12-31 23:59:59' AS TIMESTAMP) as valid_to, true as is_current UNION ALL
  -- mat2: is current
  SELECT 'mat2' as material_id, 'Aluminum' as material_name, CAST('2026-01-20 10:00:00' AS TIMESTAMP) as valid_from, CAST('9999-12-31 23:59:59' AS TIMESTAMP) as valid_to, true as is_current
}

  SELECT 'mat1' as material_id, 'Stainless Steel' as material_name, CAST('2026-02-20 10:00:00' AS TIMESTAMP) as valid_from, CAST('9999-12-31 23:59:59' AS TIMESTAMP) as valid_to, true as is_current UNION ALL
  SELECT 'mat2' as material_id, 'Aluminum' as material_name, CAST('2026-01-20 10:00:00' AS TIMESTAMP) as valid_from, CAST('9999-12-31 23:59:59' AS TIMESTAMP) as valid_to, true as is_current
