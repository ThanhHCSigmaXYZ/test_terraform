config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "fct_machine_sensor",
  description: "センサー推移分析用のファクトテーブル",
  bigquery: {
    partitionBy: "telemetry_date",
    clusterBy: ["product_serial_no", "machine_id"]
  }
}

SELECT
  s.machine_id,
  s.telemetry_timestamp,
  s.telemetry_date,
  s.avg_temperature,
  s.avg_vibration,
  p.product_serial_no
FROM
  ${ref("tmp_iot_cnc_resampled")} AS s
LEFT JOIN
  ${ref("fct_production_performance")} AS p
  ON s.machine_id = p.equipment_id -- Assuming machine_id maps to equipment_id
  AND s.telemetry_timestamp BETWEEN p.start_time AND p.end_time
