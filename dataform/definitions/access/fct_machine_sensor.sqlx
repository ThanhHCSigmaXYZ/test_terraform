config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "fct_machine_sensor",
  tags: ["access", "fact"],
  bigquery: {
    partitionBy: "telemetry_date",
    clusterBy: ["product_serial_no", "machine_id"]
  }
}

SELECT
  sns.machine_id,
  sns.telemetry_timestamp,
  DATE(sns.telemetry_timestamp) AS telemetry_date,
  perf.product_serial_no,
  sns.temperature,
  sns.vibration
FROM
  ${ref("tmp_iot_cnc_resampled")} AS sns
LEFT JOIN
  ${ref("fct_production_performance")} AS perf
  ON sns.machine_id = perf.equipment_id
  AND sns.telemetry_timestamp BETWEEN perf.start_time AND perf.end_time