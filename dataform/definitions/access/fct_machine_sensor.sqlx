config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "fct_machine_sensor",
  tags: ["access"],
  description: "センサー推移分析用のファクトテーブル作成",
  dataformCore: "3.0.7",
  partitionBy: "telemetry_date",
  clusterBy: ["product_serial_no", "machine_id"]
}

SELECT
  s.machine_id,
  s.telemetry_timestamp,
  s.telemetry_date,
  p.product_serial_no
FROM
  ${ref("tmp_iot_cnc_resampled")} s
LEFT JOIN
  ${ref("fct_production_performance")} p ON s.machine_id = p.equipment_id AND s.telemetry_timestamp BETWEEN p.start_time AND p.end_time
