config {
    type: "table",
    schema: "dev_dataform_dataset",
    name: "fct_production_performance",
    partition_by: "production_date",
    cluster_by: ["material_id", "worker_id"]
}

SELECT
    fact.*,
    dim_mat.material_name,
    dim_w.worker_name,
    TIMESTAMP_DIFF(fact.end_time, fact.start_time, SECOND) as manufacturing_lead_time_sec
FROM
    ${ref("tmp_mes_prd_order_cleansed")} AS fact
LEFT JOIN
    ${ref("dim_material")} AS dim_mat ON fact.material_id = dim_mat.material_id
    -- Join on the dimension that was valid at the time of production
    AND fact.production_date >= dim_mat.valid_from AND fact.production_date < dim_mat.valid_to
LEFT JOIN
    ${ref("dim_worker")} AS dim_w ON fact.worker_id = dim_w.worker_id
    AND fact.production_date >= dim_w.valid_from AND fact.production_date < dim_w.valid_to
