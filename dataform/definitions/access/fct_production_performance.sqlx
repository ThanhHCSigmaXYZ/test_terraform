config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "fct_production_performance",
  tags: ["access", "fact"],
  bigquery: {
    partitionBy: "production_date",
    clusterBy: ["material_id", "worker_id"]
  }
}

SELECT
  ord.order_id,
  ord.product_serial_no,
  ord.production_date,
  mat.material_id,
  wrk.worker_id,
  TIMESTAMP_DIFF(ord.end_time, ord.start_time, SECOND) AS production_lead_time_sec
FROM
  ${ref("tmp_mes_prd_order_cleansed")} AS ord
LEFT JOIN
  ${ref("dim_material")} AS mat
  ON ord.material_id = mat.material_id
LEFT JOIN
  ${ref("dim_worker")} AS wrk
  ON ord.worker_id = wrk.worker_id