-- NOTE: mock data designed for deterministic JOIN results
config {
  type: "test",
  dataset: "fct_quality_inspection"
}

input "tmp_qms_inspection_std" {
  SELECT 'insp1' as inspection_id, 'psn1' as product_serial_no, DATE('2026-03-17') as inspection_date, 10.5 as measurement_a, 25.0 as measurement_b_mm UNION ALL
  SELECT 'insp2' as inspection_id, 'psn2' as product_serial_no, DATE('2026-03-17') as inspection_date, 11.0 as measurement_a, 25.1 as measurement_b_mm UNION ALL
  SELECT 'insp3' as inspection_id, 'psn3' as product_serial_no, DATE('2026-03-18') as inspection_date, 9.8 as measurement_a, 22.0 as measurement_b_mm
}

input "fct_production_performance" {
  SELECT 'psn1' as product_serial_no, 'o1' as order_id, 'w1' as worker_id, 3600 as production_lead_time_sec UNION ALL
  SELECT 'psn2' as product_serial_no, 'o2' as order_id, 'w2' as worker_id, 1800 as production_lead_time_sec
}

SELECT 'insp1' as inspection_id, 'psn1' as product_serial_no, DATE('2026-03-17') as inspection_date, 10.5 as measurement_a, 25.0 as measurement_b_mm, 'o1' as order_id, 'w1' as worker_id, 3600 as production_lead_time_sec UNION ALL
SELECT 'insp2' as inspection_id, 'psn2' as product_serial_no, DATE('2026-03-17') as inspection_date, 11.0 as measurement_a, 25.1 as measurement_b_mm, 'o2' as order_id, 'w2' as worker_id, 1800 as production_lead_time_sec UNION ALL
SELECT 'insp3' as inspection_id, 'psn3' as product_serial_no, DATE('2026-03-18') as inspection_date, 9.8 as measurement_a, 22.0 as measurement_b_mm, NULL as order_id, NULL as worker_id, NULL as production_lead_time_sec
