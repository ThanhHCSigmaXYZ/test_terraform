config {
  type: "test",
  dataset: "fct_quality_inspection",
  name: "fct_quality_inspection_test"
}

-- NOTE: mock data designed for deterministic JOIN results
input "tmp_qms_inspection_std" {
  SELECT 'insp1' as inspection_id, 's1' as product_serial_no, DATE('2023-01-15') as inspection_date UNION ALL
  SELECT 'insp2' as inspection_id, 's2' as product_serial_no, DATE('2023-01-16') as inspection_date UNION ALL
  SELECT 'insp3' as inspection_id, 's3' as product_serial_no, DATE('2023-01-17') as inspection_date UNION ALL
  SELECT 'insp4' as inspection_id, 's4' as product_serial_no, DATE('2023-01-18') as inspection_date UNION ALL
  SELECT 'insp5' as inspection_id, 's5' as product_serial_no, DATE('2023-01-19') as inspection_date
}

input "fct_production_performance" {
  SELECT 's1' as product_serial_no, 'order1' as order_id, 'w1' as worker_id, 'mat1' as material_id, 3600 as production_lead_time_sec UNION ALL
  SELECT 's2' as product_serial_no, 'order2' as order_id, 'w2' as worker_id, 'mat2' as material_id, 1800 as production_lead_time_sec UNION ALL
  SELECT 's3' as product_serial_no, 'order3' as order_id, 'w1' as worker_id, 'mat1' as material_id, 7200 as production_lead_time_sec
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT
  'insp1' as inspection_id, 's1' as product_serial_no, DATE('2023-01-15') as inspection_date, 'order1' as order_id, 'w1' as worker_id, 'mat1' as material_id, 3600 as production_lead_time_sec UNION ALL
  SELECT 'insp2' as inspection_id, 's2' as product_serial_no, DATE('2023-01-16') as inspection_date, 'order2' as order_id, 'w2' as worker_id, 'mat2' as material_id, 1800 as production_lead_time_sec UNION ALL
  SELECT 'insp3' as inspection_id, 's3' as product_serial_no, DATE('2023-01-17') as inspection_date, 'order3' as order_id, 'w1' as worker_id, 'mat1' as material_id, 7200 as production_lead_time_sec UNION ALL
  SELECT 'insp4' as inspection_id, 's4' as product_serial_no, DATE('2023-01-18') as inspection_date, NULL as order_id, NULL as worker_id, NULL as material_id, NULL as production_lead_time_sec UNION ALL
  SELECT 'insp5' as inspection_id, 's5' as product_serial_no, DATE('2023-01-19') as inspection_date, NULL as order_id, NULL as worker_id, NULL as material_id, NULL as production_lead_time_sec
