-- NOTE: mock data designed for deterministic JOIN results
config {
    type: "test",
    dataset: "fct_quality_inspection"
}

input {
    name: "tmp_qms_inspection_std",
    data: [
        {inspection_id: "insp1", product_serial_no: "serial1", inspection_date: DATE("2023-01-01"), inspection_value_mm: 10.5},
        {inspection_id: "insp2", product_serial_no: "serial2", inspection_date: DATE("2023-01-02"), inspection_value_mm: 12.0}
    ]
}
input {
    name: "fct_production_performance",
    data: [
        {order_id: "order1", product_serial_no: "serial1", start_time: TIMESTAMP("2023-01-01 10:00:00"), end_time: TIMESTAMP("2023-01-01 11:00:00"), worker_id: "w1", material_id: "mat1", manufacturing_lead_time_sec: 3600},
        {order_id: "order2", product_serial_no: "serial2", start_time: TIMESTAMP("2023-01-02 12:00:00"), end_time: TIMESTAMP("2023-01-02 12:30:00"), worker_id: "w2", material_id: "mat2", manufacturing_lead_time_sec: 1800}
    ]
}

SELECT
    "insp1" as inspection_id, "serial1" as product_serial_no, DATE("2023-01-01") as inspection_date, 10.5 as inspection_value_mm, "order1" as order_id, TIMESTAMP("2023-01-01 10:00:00") as start_time, TIMESTAMP("2023-01-01 11:00:00") as end_time, "w1" as worker_id, "mat1" as material_id, 3600 as manufacturing_lead_time_sec
UNION ALL
SELECT
    "insp2" as inspection_id, "serial2" as product_serial_no, DATE("2023-01-02") as inspection_date, 12.0 as inspection_value_mm, "order2" as order_id, TIMESTAMP("2023-01-02 12:00:00") as start_time, TIMESTAMP("2023-01-02 12:30:00") as end_time, "w2" as worker_id, "mat2" as material_id, 1800 as manufacturing_lead_time_sec
