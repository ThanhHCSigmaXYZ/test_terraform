-- NOTE: mock data designed for deterministic JOIN results
config {
  type: "test",
  dataset: "fct_quality_inspection"
}

input "tmp_qms_inspection_std" {
  SELECT 1 AS inspection_id, 'PN-1' AS product_serial_no, 10.5 AS result_mm, DATE('2023-01-01') AS inspection_date UNION ALL
  SELECT 2 AS inspection_id, 'PN-2' AS product_serial_no, 12.0 AS result_mm, DATE('2023-01-02') AS inspection_date
}

input "fct_production_performance" {
  SELECT 'PN-1' AS product_serial_no, 'W-1' AS worker_id, 'C-1' AS machine_id UNION ALL
  SELECT 'PN-2' AS product_serial_no, 'W-2' AS worker_id, 'C-2' AS machine_id
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT 1 AS inspection_id, 'PN-1' AS product_serial_no, 10.5 AS result_mm, 'W-1' AS worker_id, 'C-1' AS machine_id, DATE('2023-01-01') AS inspection_date UNION ALL
SELECT 2 AS inspection_id, 'PN-2' AS product_serial_no, 12.0 AS result_mm, 'W-2' AS worker_id, 'C-2' AS machine_id, DATE('2023-01-02') AS inspection_date
