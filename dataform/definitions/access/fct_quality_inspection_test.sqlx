config {
  type: "test",
  dataset: "fct_quality_inspection"
}
-- NOTE: mock data designed for deterministic JOIN results
input "tmp_qms_inspection_std" {
  SELECT 'insp1' as inspection_id, 'psn1' as product_serial_no, DATE('2023-01-10') as inspection_date, 10.5 as measurement_value_cm UNION ALL
  SELECT 'insp2' as inspection_id, 'psn2' as product_serial_no, DATE('2023-01-11') as inspection_date, 12.5 as measurement_value_cm
}
input "fct_production_performance" {
  SELECT 'psn1' as product_serial_no, 'o1' as order_id, 3600 as production_lead_time_seconds, 'mat1' as material_id, 'w1' as worker_id UNION ALL
  SELECT 'psn2' as product_serial_no, 'o2' as order_id, 7200 as production_lead_time_seconds, 'mat2' as material_id, 'w2' as worker_id
}

SELECT
  'insp1' as inspection_id, 'psn1' as product_serial_no, DATE('2023-01-10') as inspection_date, 10.5 as measurement_value_cm, 'o1' as order_id, 3600 as production_lead_time_seconds, 'mat1' as material_id, 'w1' as worker_id
UNION ALL
SELECT
  'insp2' as inspection_id, 'psn2' as product_serial_no, DATE('2023-01-11') as inspection_date, 12.5 as measurement_value_cm, 'o2' as order_id, 7200 as production_lead_time_seconds, 'mat2' as material_id, 'w2' as worker_id
