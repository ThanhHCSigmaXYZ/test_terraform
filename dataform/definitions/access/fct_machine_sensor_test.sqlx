-- NOTE: mock data designed for deterministic JOIN results
config {
    type: "test",
    dataset: "fct_machine_sensor"
}

input {
    name: "tmp_iot_cnc_resampled",
    data: [
        -- Sensor data during production of serial1
        {machine_id: "eq1", telemetry_timestamp: TIMESTAMP("2023-01-01 10:15:00"), telemetry_date: DATE("2023-01-01"), temperature: 210.5, vibration: 0.15},
        -- Sensor data outside of any production
        {machine_id: "eq1", telemetry_timestamp: TIMESTAMP("2023-01-01 11:30:00"), telemetry_date: DATE("2023-01-01"), temperature: 150.0, vibration: 0.05},
        -- Sensor data during production of serial2
        {machine_id: "eq2", telemetry_timestamp: TIMESTAMP("2023-01-02 14:30:00"), telemetry_date: DATE("2023-01-02"), temperature: 280.0, vibration: 0.25}
    ]
}
input {
    name: "fct_production_performance",
    data: [
        -- NOTE: [timestamp_col] is designed to fall between [start_col] and [end_col]
        {order_id: "order1", product_serial_no: "serial1", equipment_id: "eq1", start_time: TIMESTAMP("2023-01-01 10:00:00"), end_time: TIMESTAMP("2023-01-01 11:00:00")},
        {order_id: "order2", product_serial_no: "serial2", equipment_id: "eq2", start_time: TIMESTAMP("2023-01-02 14:00:00"), end_time: TIMESTAMP("2023-01-02 15:00:00")}
    ]
}

SELECT
    "eq1" as machine_id, TIMESTAMP("2023-01-01 10:15:00") as telemetry_timestamp, DATE("2023-01-01") as telemetry_date, 210.5 as temperature, 0.15 as vibration, "serial1" as product_serial_no
UNION ALL
SELECT
    "eq1" as machine_id, TIMESTAMP("2023-01-01 11:30:00") as telemetry_timestamp, DATE("2023-01-01") as telemetry_date, 150.0 as temperature, 0.05 as vibration, NULL as product_serial_no
UNION ALL
SELECT
    "eq2" as machine_id, TIMESTAMP("2023-01-02 14:30:00") as telemetry_timestamp, DATE("2023-01-02") as telemetry_date, 280.0 as temperature, 0.25 as vibration, "serial2" as product_serial_no
