config {
  type: "test",
  dataset: "fct_machine_sensor"
}
-- NOTE: mock data designed for deterministic JOIN results
input "tmp_iot_cnc_resampled" {
  SELECT 'm1' as machine_id, TIMESTAMP('2023-01-01 10:15:00') as telemetry_timestamp, DATE('2023-01-01') as telemetry_date, 105.5 as temperature, 0.55 as vibration UNION ALL
  SELECT 'm2' as machine_id, TIMESTAMP('2023-01-01 12:45:00') as telemetry_timestamp, DATE('2023-01-01') as telemetry_date, 155.0 as temperature, 1.55 as vibration
}
input "fct_production_performance" {
  -- NOTE: [timestamp_col] is designed to fall between [start_col] and [end_col]
  SELECT 'psn1' as product_serial_no, 'm1' as machine_id, TIMESTAMP('2023-01-01 10:00:00') as start_time, TIMESTAMP('2023-01-01 11:00:00') as end_time UNION ALL
  SELECT 'psn2' as product_serial_no, 'm2' as machine_id, TIMESTAMP('2023-01-01 12:00:00') as start_time, TIMESTAMP('2023-01-01 13:00:00') as end_time
}

SELECT
  'm1' as machine_id, TIMESTAMP('2023-01-01 10:15:00') as telemetry_timestamp, DATE('2023-01-01') as telemetry_date, 105.5 as temperature, 0.55 as vibration, 'psn1' as product_serial_no
UNION ALL
SELECT
  'm2' as machine_id, TIMESTAMP('2023-01-01 12:45:00') as telemetry_timestamp, DATE('2023-01-01') as telemetry_date, 155.0 as temperature, 1.55 as vibration, 'psn2' as product_serial_no
