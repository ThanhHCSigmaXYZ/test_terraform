config {
  type: "test",
  dataset: "fct_machine_sensor"
}

-- NOTE: mock data designed for deterministic JOIN results
input "tmp_iot_cnc_resampled" {
  -- This sensor reading occurs during production of serial1
  SELECT 'machine1' as machine_id, TIMESTAMP('2023-01-01 10:15:00') as telemetry_timestamp, 28.0 as temperature, 0.15 as vibration UNION ALL
  -- This sensor reading is outside production times
  SELECT 'machine1' as machine_id, TIMESTAMP('2023-01-01 09:00:00') as telemetry_timestamp, 22.0 as temperature, 0.05 as vibration
}

input "fct_production_performance" {
  SELECT 'serial1' as product_serial_no, 'machine1' as equipment_id, TIMESTAMP('2023-01-01 10:00:00') as start_time, TIMESTAMP('2023-01-01 11:00:00') as end_time
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
-- NOTE: telemetry_timestamp is designed to fall between start_time and end_time for the successful join case
SELECT
  'machine1' as machine_id,
  TIMESTAMP('2023-01-01 10:15:00') as telemetry_timestamp,
  DATE('2023-01-01') as telemetry_date,
  'serial1' as product_serial_no,
  28.0 as temperature,
  0.15 as vibration
UNION ALL
SELECT
  'machine1' as machine_id,
  TIMESTAMP('2023-01-01 09:00:00') as telemetry_timestamp,
  DATE('2023-01-01') as telemetry_date,
  NULL as product_serial_no,
  22.0 as temperature,
  0.05 as vibration