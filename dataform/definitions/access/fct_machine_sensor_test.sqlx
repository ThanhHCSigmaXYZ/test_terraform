config {
  type: "test",
  dataset: "fct_machine_sensor",
  name: "fct_machine_sensor_test"
}

-- NOTE: mock data designed for deterministic JOIN results
input "tmp_iot_cnc_resampled" {
  SELECT 'm1' as machine_id, TIMESTAMP('2023-01-10 10:05:00') as telemetry_timestamp, DATE('2023-01-10') as telemetry_date UNION ALL -- match
  SELECT 'm1' as machine_id, TIMESTAMP('2023-01-10 11:00:00') as telemetry_timestamp, DATE('2023-01-10') as telemetry_date UNION ALL -- no match
  SELECT 'm2' as machine_id, TIMESTAMP('2023-01-11 12:15:00') as telemetry_timestamp, DATE('2023-01-11') as telemetry_date UNION ALL -- match
  SELECT 'm1' as machine_id, TIMESTAMP('2023-01-12 10:00:00') as telemetry_timestamp, DATE('2023-01-12') as telemetry_date UNION ALL -- no match
  SELECT 'm2' as machine_id, TIMESTAMP('2023-01-13 10:00:00') as telemetry_timestamp, DATE('2023-01-13') as telemetry_date     -- no match
}

input "fct_production_performance" {
  -- NOTE: [timestamp_col] is designed to fall between [start_col] and [end_col]
  SELECT 's1' as product_serial_no, 'm1' as equipment_id, TIMESTAMP('2023-01-10 10:00:00') as start_time, TIMESTAMP('2023-01-10 10:30:00') as end_time UNION ALL
  SELECT 's2' as product_serial_no, 'm2' as equipment_id, TIMESTAMP('2023-01-11 12:00:00') as start_time, TIMESTAMP('2023-01-11 13:00:00') as end_time
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT
  'm1' as machine_id, TIMESTAMP('2023-01-10 10:05:00') as telemetry_timestamp, DATE('2023-01-10') as telemetry_date, 's1' as product_serial_no UNION ALL
  SELECT 'm1' as machine_id, TIMESTAMP('2023-01-10 11:00:00') as telemetry_timestamp, DATE('2023-01-10') as telemetry_date, NULL as product_serial_no UNION ALL
  SELECT 'm2' as machine_id, TIMESTAMP('2023-01-11 12:15:00') as telemetry_timestamp, DATE('2023-01-11') as telemetry_date, 's2' as product_serial_no UNION ALL
  SELECT 'm1' as machine_id, TIMESTAMP('2023-01-12 10:00:00') as telemetry_timestamp, DATE('2023-01-12') as telemetry_date, NULL as product_serial_no UNION ALL
  SELECT 'm2' as machine_id, TIMESTAMP('2023-01-13 10:00:00') as telemetry_timestamp, DATE('2023-01-13') as telemetry_date, NULL as product_serial_no
