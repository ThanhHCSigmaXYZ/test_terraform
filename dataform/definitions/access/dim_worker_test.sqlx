-- NOTE: mock data designed for deterministic JOIN results
config {
  type: "test",
  dataset: "dim_worker"
}

input "tmp_erp_worker_master_scd2" {
  -- w1: only the last record is current
  SELECT 'w1' as worker_id, 'Sato' as worker_name, CAST('2026-01-15 10:00:00' AS TIMESTAMP) as valid_from, CAST('2026-02-20 10:00:00' AS TIMESTAMP) as valid_to, false as is_current UNION ALL
  SELECT 'w1' as worker_id, 'Sato Ken' as worker_name, CAST('2026-02-20 10:00:00' AS TIMESTAMP) as valid_from, CAST('9999-12-31 23:59:59' AS TIMESTAMP) as valid_to, true as is_current UNION ALL
  -- w2: is current
  SELECT 'w2' as worker_id, 'Tanaka' as worker_name, CAST('2026-01-20 10:00:00' AS TIMESTAMP) as valid_from, CAST('9999-12-31 23:59:59' AS TIMESTAMP) as valid_to, true as is_current
}

  SELECT 'w1' as worker_id, 'Sato Ken' as worker_name, CAST('2026-02-20 10:00:00' AS TIMESTAMP) as valid_from, CAST('9999-12-31 23:59:59' AS TIMESTAMP) as valid_to, true as is_current UNION ALL
  SELECT 'w2' as worker_id, 'Tanaka' as worker_name, CAST('2026-01-20 10:00:00' AS TIMESTAMP) as valid_from, CAST('9999-12-31 23:59:59' AS TIMESTAMP) as valid_to, true as is_current
