  SELECT 'W-4' AS worker_id, 'Worker 4 v1' AS name, TIMESTAMP('2023-01-04 00:00:00') AS valid_from, TIMESTAMP('9999-12-31 23:59:59') AS valid_to, true AS is_current
}

