config {
  type: "test",
  dataset: "dim_worker"
}

-- NOTE: mock data designed for deterministic JOIN results
input "tmp_erp_worker_master_scd2" {
  SELECT 'w1' as worker_id, 'Worker 1 Old' as worker_name, false as is_current UNION ALL
  SELECT 'w1' as worker_id, 'Worker 1 Current' as worker_name, true as is_current UNION ALL
  SELECT 'w2' as worker_id, 'Worker 2' as worker_name, true as is_current UNION ALL
  SELECT 'w3' as worker_id, 'Worker 3' as worker_name, true as is_current UNION ALL
  SELECT 'w4' as worker_id, 'Worker 4' as worker_name, true as is_current
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT
  'w1' as worker_id,
  'Worker 1 Current' as worker_name
UNION ALL
SELECT
  'w2' as worker_id,
  'Worker 2' as worker_name
UNION ALL
SELECT
  'w3' as worker_id,
  'Worker 3' as worker_name
UNION ALL
SELECT
  'w4' as worker_id,
  'Worker 4' as worker_name