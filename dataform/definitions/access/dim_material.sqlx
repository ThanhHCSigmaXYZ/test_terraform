config {
  type: "table",
  schema: "dev_dataform_dataset",
  name: "dim_material",
  tags: ["access"],
  description: "Material dimension table, derived from SCD2 history.",
  dataformCore: "3.0.7",
  clusterBy: ["material_id"]
}

SELECT
  material_id,
  material_name,
  valid_from,
  valid_to,
  is_current
FROM
  ${ref("tmp_erp_mat_master_scd2")}
