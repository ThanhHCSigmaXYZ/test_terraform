config {
  type: "test",
  dataset: "fct_production_performance"
}

-- NOTE: mock data designed for deterministic JOIN results
input "tmp_mes_prd_order_cleansed" {
  SELECT 'order1' as order_id, 'serial1' as product_serial_no, DATE('2023-01-01') as production_date, 'mat1' as material_id, 'w1' as worker_id, TIMESTAMP('2023-01-01 10:00:00') as start_time, TIMESTAMP('2023-01-01 11:00:00') as end_time UNION ALL
  SELECT 'order2' as order_id, 'serial2' as product_serial_no, DATE('2023-01-02') as production_date, 'mat2' as material_id, 'w2' as worker_id, TIMESTAMP('2023-01-02 12:00:00') as start_time, TIMESTAMP('2023-01-02 12:30:00') as end_time
}

input "dim_material" {
  SELECT 'mat1' as material_id, 'Material 1' as material_name UNION ALL
  SELECT 'mat2' as material_id, 'Material 2' as material_name
}

input "dim_worker" {
  SELECT 'w1' as worker_id, 'Worker 1' as worker_name UNION ALL
  SELECT 'w2' as worker_id, 'Worker 2' as worker_name
}

-- NOTE: expected output derived from mock data — verify if transformation logic changes
SELECT
  'order1' as order_id,
  'serial1' as product_serial_no,
  DATE('2023-01-01') as production_date,
  'mat1' as material_id,
  'w1' as worker_id,
  3600 as production_lead_time_sec
UNION ALL
SELECT
  'order2' as order_id,
  'serial2' as product_serial_no,
  DATE('2023-01-02') as production_date,
  'mat2' as material_id,
  'w2' as worker_id,
  1800 as production_lead_time_sec