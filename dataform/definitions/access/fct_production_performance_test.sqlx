-- NOTE: mock data designed for deterministic JOIN results
config {
  type: "test",
  dataset: "fct_production_performance"
}

input "tmp_mes_prd_order_cleansed" {
  SELECT 'order1' as order_id, 'psn1' as product_serial_no, 'mat1' as material_id, 'w1' as worker_id, CAST('2026-03-17 10:00:00' AS TIMESTAMP) as start_time, CAST('2026-03-17 11:30:00' AS TIMESTAMP) as end_time, DATE '2026-03-17' as production_date UNION ALL
  SELECT 'order2' as order_id, 'psn2' as product_serial_no, 'mat2' as material_id, 'w2' as worker_id, CAST('2026-03-17 12:00:00' AS TIMESTAMP) as start_time, CAST('2026-03-17 12:45:00' AS TIMESTAMP) as end_time, DATE '2026-03-17' as production_date
}

input "dim_material" {
  SELECT 'mat1' as material_id, 'Stainless Steel' as material_name UNION ALL
  SELECT 'mat2' as material_id, 'Aluminum' as material_name
}

input "dim_worker" {
  SELECT 'w1' as worker_id, 'Sato Ken' as worker_name UNION ALL
  SELECT 'w2' as worker_id, 'Tanaka' as worker_name
}

  SELECT 'order1' as order_id, 'psn1' as product_serial_no, 'mat1' as material_id, 'w1' as worker_id, CAST('2026-03-17 10:00:00' AS TIMESTAMP) as start_time, CAST('2026-03-17 11:30:00' AS TIMESTAMP) as end_time, DATE '2026-03-17' as production_date, 'Stainless Steel' as material_name, 'Sato Ken' as worker_name, 5400 as production_lead_time_sec UNION ALL
  SELECT 'order2' as order_id, 'psn2' as product_serial_no, 'mat2' as material_id, 'w2' as worker_id, CAST('2026-03-17 12:00:00' AS TIMESTAMP) as start_time, CAST('2026-03-17 12:45:00' AS TIMESTAMP) as end_time, DATE '2026-03-17' as production_date, 'Aluminum' as material_name, 'Tanaka' as worker_name, 2700 as production_lead_time_sec
